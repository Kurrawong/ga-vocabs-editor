      }
    ]
  },
  {
    "@id": "https://pid.geoscience.gov.au/def/voc/ga/LandformTypes/alluvial-plain",
    "https://prez.dev/identifier": [
      {
        "@value": "ns1:alluvial-plain"
      }
    ],
    "https://prez.dev/link": [
      {
        "@value": "/catalogs/catalogue:default/collections/ns1:LandformTypes/items/ns1:alluvial-plain"
      }
    ],
    "https://prez.dev/label": [
      {
        "@value": "alluvial plain",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "A level, gently sloping or slightly undulating land surface produced by extensive deposition of alluvium, generally adjacent to a river that periodically overflows its banks; it may be situated on a flood plain, a delta, or an alluvial fan.",
        "@language": "en"
      }
    ]
  },
  {
    "@id": "https://pid.geoscience.gov.au/def/voc/ga/LandformTypes/alluvial-swamp",
    "https://prez.dev/identifier": [
      {
        "@value": "ns1:alluvial-swamp"
      }
    ],
    "https://prez.dev/link": [
      {
        "@value": "/catalogs/catalogue:default/collections/ns1:LandformTypes/items/ns1:alluvial-swamp"
      }
    ],
    "https://prez.dev/label": [
      {
        "@value": "alluvial swamp",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "An almost level, closed, or almost closed, depression with a seasonal or permanent water table at or above the surface, commonly aggraded by over-bank stream flow and sometimes biological (peat) accumulation.",
        "@language": "en"
      }
    ]
  },
  {
    "@id": "https://pid.geoscience.gov.au/def/voc/ga/LandformTypes/alluvial-terrace",
    "https://prez.dev/identifier": [
      {
        "@value": "ns1:alluvial-terrace"
      }
    ],
    "https://prez.dev/link": [
      {
        "@value": "/catalogs/catalogue:default/collections/ns1:LandformTypes/items/ns1:alluvial-terrace"
      }
    ],
    "https://prez.dev/label": [
      {
        "@value": "alluvial terrace",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "A former flood plain on which erosion and aggradation by channelled and over-bank stream flow is slightly active or inactive because of deepening or enlargement of the stream channel has lowered the level of flooding. A pattern that includes a significant active flood plain, or former flood plains at more than one level, becomes terraced land.",
        "@language": "en"
      }
    ]
  },
  {
    "@id": "https://pid.geoscience.gov.au/def/voc/ga/LandformTypes/anastomatic-plain",
    "https://prez.dev/identifier": [
      {
        "@value": "ns1:anastomatic-plain"
      }
    ],
    "https://prez.dev/link": [
      {
        "@value": "/catalogs/catalogue:default/collections/ns1:LandformTypes/items/ns1:anastomatic-plain"
      }
    ],
    "https://prez.dev/label": [
      {
        "@value": "anastomatic plain",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "A flood plain on which the stream channels join and divide, as do the veins on a leaf. Flood plain with slowly migrating, deep alluvial channels, usually moderately spaced, forming a divergent to unidirectional integrated reticulated network. There is frequently active aggradation by over-bank and channelled stream flow.",
        "@language": "en"
      }
    ]
  },
  {
    "@id": "https://pid.geoscience.gov.au/def/voc/ga/LandformTypes/bar-plain",
    "https://prez.dev/identifier": [
      {
        "@value": "ns1:bar-plain"
      }
    ],
    "https://prez.dev/link": [
      {
        "@value": "/catalogs/catalogue:default/collections/ns1:LandformTypes/items/ns1:bar-plain"
      }
    ],
    "https://prez.dev/label": [
      {
        "@value": "bar plain",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "A flood plain having sub-parallel stream channels that both aggrade and erode so as to develop a generally corrugated surface with numerous bars. Flood plain with numerous rapidly migrating shallow alluvial channels forming a unidirectional integrated reticulated network. There is frequently active aggradation and erosion by channelled stream flow.",
        "@language": "en"
      }
    ]
  },
  {
    "@id": "https://pid.geoscience.gov.au/def/voc/ga/LandformTypes/covered-plain",
    "https://prez.dev/identifier": [
      {
        "@value": "ns1:covered-plain"
      }
    ],
    "https://prez.dev/link": [
      {
        "@value": "/catalogs/catalogue:default/collections/ns1:LandformTypes/items/ns1:covered-plain"
      }
    ],
    "https://prez.dev/label": [
      {
        "@value": "covered plain",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "A flood plain with a number of alluvial channels that are widely-spaced (i.e. a little under 1 km), migrating, more or less parallel, and deep (i.e. width-depth ratio <20:1). Aggradation by over-bank stream flow occurs at least once every 50 years, providing further alluvial cover.",
        "@language": "en"
      }
    ]
  },
  {
    "@id": "https://pid.geoscience.gov.au/def/voc/ga/LandformTypes/flood-plain",
    "https://prez.dev/identifier": [
      {
        "@value": "ns1:flood-plain"
      }
    ],
    "https://prez.dev/link": [
      {
        "@value": "/catalogs/catalogue:default/collections/ns1:LandformTypes/items/ns1:flood-plain"
      }
    ],
    "https://prez.dev/label": [
      {
        "@value": "flood plain",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "An alluvial plain characterised by frequently active aggradation by overbank stream flow (i.e. by flooding more often than every 50 years) and erosion by channelled stream flow.",
        "@language": "en"
      }
    ]
  },
  {
    "@id": "https://pid.geoscience.gov.au/def/voc/ga/LandformTypes/floodout",
    "https://prez.dev/identifier": [
      {
        "@value": "ns1:floodout"
      }
    ],
    "https://prez.dev/link": [
      {
        "@value": "/catalogs/catalogue:default/collections/ns1:LandformTypes/items/ns1:floodout"
      }
    ],
    "https://prez.dev/label": [
      {
        "@value": "floodout",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "A flat inclined radially away from a point on the margin, or at the end, of a stream channel, aggraded by over-bank stream flow, or by channelled stream flow associated with channels developed within the over-bank part.",
        "@language": "en"
      }
    ]
  },
  {
    "@id": "https://pid.geoscience.gov.au/def/voc/ga/LandformTypes/meander-plain",
    "https://prez.dev/identifier": [
      {
        "@value": "ns1:meander-plain"
      }
    ],
    "https://prez.dev/link": [
      {
        "@value": "/catalogs/catalogue:default/collections/ns1:LandformTypes/items/ns1:meander-plain"
      }
    ],
    "https://prez.dev/label": [
      {
        "@value": "meander plain",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "A flood plain aggraded and eroded by meandering streams. Flood plain with widely spaced, rapidly migrating, moderately deep alluvial stream channels that form a unidirectional integrated non-tributary network. There is frequently active aggradation and erosion by channelled stream flow, with subordinate aggradation by over-bank stream flow.",
        "@language": "en"
      }
    ]
  },
  {
    "@id": "https://pid.geoscience.gov.au/def/voc/ga/LandformTypes/stagnant-alluvial-plain",
    "https://prez.dev/identifier": [
      {
        "@value": "ns1:stagnant-alluvial-plain"
      }
    ],
    "https://prez.dev/link": [
      {
        "@value": "/catalogs/catalogue:default/collections/ns1:LandformTypes/items/ns1:stagnant-alluvial-plain"
      }
    ],
    "https://prez.dev/label": [
      {
        "@value": "stagnant alluvial plain",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "An alluvial plain on which erosion and aggradation by channelled and over-bank stream flow is slightly active or inactive because of reduced water supply, without apparent incision or channel enlargement that would lower the level of stream action.",
        "@language": "en"
      }
    ]
  },
  {
    "@id": "https://pid.geoscience.gov.au/def/voc/ga/LandformTypes/stream-channel",
    "https://prez.dev/identifier": [
      {
        "@value": "ns1:stream-channel"
      }
    ],
    "https://prez.dev/link": [
      {
        "@value": "/catalogs/catalogue:default/collections/ns1:LandformTypes/items/ns1:stream-channel"
      }
    ],
    "https://prez.dev/label": [
      {
        "@value": "stream channel",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "A linear, generally sinuous open depression - eroded in parts - excavated, built up and aggraded by channelled stream flow. This element comprises stream beds and banks.",
        "@language": "en"
      }
    ]
  },
  {
    "@id": "https://pid.geoscience.gov.au/def/voc/ga/LandformTypes/terraced-land",
    "https://prez.dev/identifier": [
      {
        "@value": "ns1:terraced-land"
      }
    ],
    "https://prez.dev/link": [
      {
        "@value": "/catalogs/catalogue:default/collections/ns1:LandformTypes/items/ns1:terraced-land"
      }
    ],
    "https://prez.dev/label": [
      {
        "@value": "terraced land",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "A landform pattern including one or more terraces and often a flood plain. Relief is low or very low (9-90 m). Terrace plains or terrace flats occur at stated heights above the top of the stream bank.",
        "@language": "en"
      }
    ]
  },
