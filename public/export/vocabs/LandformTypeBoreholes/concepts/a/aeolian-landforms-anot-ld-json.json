  {
    "@id": "https://pid.geoscience.gov.au/def/voc/ga/LandformTypes/aeolian-dunes",
    "https://prez.dev/identifier": [
      {
        "@value": "ns1:aeolian-dunes"
      }
    ],
    "https://prez.dev/link": [
      {
        "@value": "/catalogs/catalogue:default/collections/ns1:LandformTypes/items/ns1:aeolian-dunes"
      }
    ],
    "https://prez.dev/label": [
      {
        "@value": "aeolian dunes",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "Low mounds, ridges, banks, or hills of loose, windblown granular material (generally sand; in some places volcanic ash), either bare or covered with vegetation, capable of being moved from place to place by wind, but always retaining their own characteristic shape.",
        "@language": "en"
      }
    ]
  },
  {
