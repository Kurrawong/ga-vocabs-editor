  {
    "@id": "https://pid.geoscience.gov.au/def/voc/ga/LandformTypes/aeolian-sheet",
    "https://prez.dev/identifier": [
      {
        "@value": "ns1:aeolian-sheet"
      }
    ],
    "https://prez.dev/link": [
      {
        "@value": "/catalogs/catalogue:default/collections/ns1:LandformTypes/items/ns1:aeolian-sheet"
      }
    ],
    "https://prez.dev/label": [
      {
        "@value": "aeolian sheet",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "A sheet of aeolian material- generally sand - formed when wind moulding of the surface is prevented either by vegetation or, more usually, because the sand grains are too coarse. They are commonly associated with sources that give rise to coarse sand grains, such as alluvial plains, or the weathering of coarse-grained granite, as occurs in the Yilgarn of Western Australia.",
        "@language": "en"
      }
    ]
  },
  {
    "@id": "https://pid.geoscience.gov.au/def/voc/ga/LandformTypes/irregular-dune-field",
    "https://prez.dev/identifier": [
      {
        "@value": "ns1:irregular-dune-field"
      }
    ],
    "https://prez.dev/link": [
      {
        "@value": "/catalogs/catalogue:default/collections/ns1:LandformTypes/items/ns1:irregular-dune-field"
      }
    ],
    "https://prez.dev/label": [
      {
        "@value": "irregular dune field",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "A dune field with a mixture of longitudinal and transverse dunes, as well as other more complicated forms.",
        "@language": "en"
      }
    ]
  },
  {
    "@id": "https://pid.geoscience.gov.au/def/voc/ga/LandformTypes/longitudinal-dune-field",
    "https://prez.dev/identifier": [
      {
        "@value": "ns1:longitudinal-dune-field"
      }
    ],
    "https://prez.dev/link": [
      {
        "@value": "/catalogs/catalogue:default/collections/ns1:LandformTypes/items/ns1:longitudinal-dune-field"
      }
    ],
    "https://prez.dev/label": [
      {
        "@value": "longitudinal dune field",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "A dune field characterised by long narrow sand dunes and wide flat swales. The dunes are oriented parallel with the direction of the prevailing wind and, in cross section, one slope is typically steeper than the other.",
        "@language": "en"
      }
    ]
  },
  {
    "@id": "https://pid.geoscience.gov.au/def/voc/ga/LandformTypes/lunette",
    "https://prez.dev/identifier": [
      {
        "@value": "ns1:lunette"
      }
    ],
    "https://prez.dev/link": [
      {
        "@value": "/catalogs/catalogue:default/collections/ns1:LandformTypes/items/ns1:lunette"
      }
    ],
    "https://prez.dev/label": [
      {
        "@value": "lunette",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "An elongated, gently curved, low ridge built up by wind on the margin of a playa, typically with a moderate, wave-modified slope towards the playa and a gentle outer slope.",
        "@language": "en"
      }
    ]
  },
  {
    "@id": "https://pid.geoscience.gov.au/def/voc/ga/LandformTypes/source-bordering-dune",
    "https://prez.dev/identifier": [
      {
        "@value": "ns1:source-bordering-dune"
      }
    ],
    "https://prez.dev/link": [
      {
        "@value": "/catalogs/catalogue:default/collections/ns1:LandformTypes/items/ns1:source-bordering-dune"
      }
    ],
    "https://prez.dev/label": [
      {
        "@value": "source bordering dune",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "A dune formed adjacent to the source of the wind-blown material. Most commonly the source is a river or floodplain that supplies aeolian sediment during periods of low or no flow.",
        "@language": "en"
      }
    ]
  },
  {
    "@id": "https://pid.geoscience.gov.au/def/voc/ga/LandformTypes/transverse-dune-field",
    "https://prez.dev/identifier": [
      {
        "@value": "ns1:transverse-dune-field"
      }
    ],
    "https://prez.dev/link": [
      {
        "@value": "/catalogs/catalogue:default/collections/ns1:LandformTypes/items/ns1:transverse-dune-field"
      }
    ],
    "https://prez.dev/label": [
      {
        "@value": "transverse dune field",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "A dune field characterised by long narrow sand dunes and wide flat swales. The dunes are oriented normal to the direction of the prevailing wind and, in cross section, the windward slope is typically steeper than the lee slope.",
        "@language": "en"
      }
    ]
  },
