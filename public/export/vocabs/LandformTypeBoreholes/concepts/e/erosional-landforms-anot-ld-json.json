  {
    "@id": "https://pid.geoscience.gov.au/def/voc/ga/LandformTypes/erosional-plain",
    "https://prez.dev/identifier": [
      {
        "@value": "ns1:erosional-plain"
      }
    ],
    "https://prez.dev/link": [
      {
        "@value": "/catalogs/catalogue:default/collections/ns1:LandformTypes/items/ns1:erosional-plain"
      }
    ],
    "https://prez.dev/label": [
      {
        "@value": "erosional plain",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "A level to undulating or, rarely, rolling landform pattern of extremely low relief (< 9 m) eroded by continuously active to slightly active or inactive geomorphic processes.",
        "@language": "en"
      }
    ]
  },
  {
    "@id": "https://pid.geoscience.gov.au/def/voc/ga/LandformTypes/escarpment",
    "https://prez.dev/identifier": [
      {
        "@value": "ns1:escarpment"
      }
    ],
    "https://prez.dev/link": [
      {
        "@value": "/catalogs/catalogue:default/collections/ns1:LandformTypes/items/ns1:escarpment"
      }
    ],
    "https://prez.dev/label": [
      {
        "@value": "escarpment",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "A steep to precipitous landform pattern forming a linearly extensive, straight or sinuous inclined surface that separates terrains at different altitudes, that above the escarpment commonly being a plateau. Relief within the landform pattern may be high (hilly) or low (planar). An included cliff or scarp often marks the upper margin of the scarp.",
        "@language": "en"
      }
    ]
  },
  {
    "@id": "https://pid.geoscience.gov.au/def/voc/ga/LandformTypes/etchplain",
    "https://prez.dev/identifier": [
      {
        "@value": "ns1:etchplain"
      }
    ],
    "https://prez.dev/link": [
      {
        "@value": "/catalogs/catalogue:default/collections/ns1:LandformTypes/items/ns1:etchplain"
      }
    ],
    "https://prez.dev/label": [
      {
        "@value": "etchplain",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "A level to undulating or, rarely, rolling landform pattern of extremely low relief, initially formed by deep weathering and then erosion of the resulting weathered regolith. Removal of the weathered material may be\r\neither partial or complete.",
        "@language": "en"
      }
    ]
  },
  {
    "@id": "https://pid.geoscience.gov.au/def/voc/ga/LandformTypes/hills",
    "https://prez.dev/identifier": [
      {
        "@value": "ns1:hills"
      }
    ],
    "https://prez.dev/link": [
      {
        "@value": "/catalogs/catalogue:default/collections/ns1:LandformTypes/items/ns1:hills"
      }
    ],
    "https://prez.dev/label": [
      {
        "@value": "hills",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "A landform pattern of high relief (90 - 300 m) with gently sloping to precipitous slopes. Fixed, shallow erosional stream channels are closely to very widely spaced and form a dendritic or convergent integrated tributary network. There is continuously active erosion by wash and creep and, in some cases, rarely active erosion by landslides.",
        "@language": "en"
      }
    ]
  },
  {
    "@id": "https://pid.geoscience.gov.au/def/voc/ga/LandformTypes/low-hills",
    "https://prez.dev/identifier": [
      {
        "@value": "ns1:low-hills"
      }
    ],
    "https://prez.dev/link": [
      {
        "@value": "/catalogs/catalogue:default/collections/ns1:LandformTypes/items/ns1:low-hills"
      }
    ],
    "https://prez.dev/label": [
      {
        "@value": "low hills",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "A landform pattern of low relief (30 - 90 m) and gentle to very steep slopes, typically with fixed erosional stream channels that are closely to very widely spaced and form a dendritic or convergent integrated tributary\r\npattern. There is continuously active sheet flow, creep and channelled stream flow.",
        "@language": "en"
      }
    ]
  },
  {
    "@id": "https://pid.geoscience.gov.au/def/voc/ga/LandformTypes/mountains",
    "https://prez.dev/identifier": [
      {
        "@value": "ns1:mountains"
      }
    ],
    "https://prez.dev/link": [
      {
        "@value": "/catalogs/catalogue:default/collections/ns1:LandformTypes/items/ns1:mountains"
      }
    ],
    "https://prez.dev/label": [
      {
        "@value": "mountains",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "A landform pattern of very high relief (>300 m) with moderate to precipitous slopes and fixed erosional stream channels that are closely to very widely spaced and form a dendritic of diverging integrated tributary network. There is continuously active erosion by collapse, landslide, sheet flow, creep and channelled stream flow.",
        "@language": "en"
      }
    ]
  },
  {
    "@id": "https://pid.geoscience.gov.au/def/voc/ga/LandformTypes/pediment",
    "https://prez.dev/identifier": [
      {
        "@value": "ns1:pediment"
      }
    ],
    "https://prez.dev/link": [
      {
        "@value": "/catalogs/catalogue:default/collections/ns1:LandformTypes/items/ns1:pediment"
      }
    ],
    "https://prez.dev/label": [
      {
        "@value": "pediment",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "A gently inclined to level (<1 percent slope) landform pattern of extremely low relief, typically with numerous rapidly migrating, very shallow incipient stream channels that form a centrifugal to diverging integrated reticulated pattern. It is eroded, and locally aggraded, by frequently active channelled stream flow or sheet flow, with subordinate wind erosion. Pediments characteristically lie down-slope from adjacent hills with markedly steeper\r\nslopes.",
        "@language": "en"
      }
    ]
  },
  {
    "@id": "https://pid.geoscience.gov.au/def/voc/ga/LandformTypes/pediplain",
    "https://prez.dev/identifier": [
      {
        "@value": "ns1:pediplain"
      }
    ],
    "https://prez.dev/link": [
      {
        "@value": "/catalogs/catalogue:default/collections/ns1:LandformTypes/items/ns1:pediplain"
      }
    ],
    "https://prez.dev/label": [
      {
        "@value": "pediplain",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "A level to very gently inclined landform pattern with extremely low relief and no stream channels, eroded by slightly active sheet flow and wind. Largely relict from more effective erosion by stream flow in incipient\r\nchannels as on a pediment.",
        "@language": "en"
      }
    ]
  },
  {
    "@id": "https://pid.geoscience.gov.au/def/voc/ga/LandformTypes/peneplain",
    "https://prez.dev/identifier": [
      {
        "@value": "ns1:peneplain"
      }
    ],
    "https://prez.dev/link": [
      {
        "@value": "/catalogs/catalogue:default/collections/ns1:LandformTypes/items/ns1:peneplain"
      }
    ],
    "https://prez.dev/label": [
      {
        "@value": "peneplain",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "A level to gently undulating landform pattern with extremely low relief and sparse slowly migrating alluvial stream channels that form a nondirectional integrated tributary pattern. It is eroded by slightly active sheet flow, creep and channelled and over-bank stream flow.",
        "@language": "en"
      }
    ]
  },
  {
    "@id": "https://pid.geoscience.gov.au/def/voc/ga/LandformTypes/residual-low-hills",
    "https://prez.dev/identifier": [
      {
        "@value": "ns1:residual-low-hills"
      }
    ],
    "https://prez.dev/link": [
      {
        "@value": "/catalogs/catalogue:default/collections/ns1:LandformTypes/items/ns1:residual-low-hills"
      }
    ],
    "https://prez.dev/label": [
      {
        "@value": "residual low hills",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "A landform of low relief (30-90 m) and gentle to very steep slopes. This term is used to refer to an isolated low hill surrounded by other landforms.",
        "@language": "en"
      }
    ]
  },
  {
    "@id": "https://pid.geoscience.gov.au/def/voc/ga/LandformTypes/residual-rise",
    "https://prez.dev/identifier": [
      {
        "@value": "ns1:residual-rise"
      }
    ],
    "https://prez.dev/link": [
      {
        "@value": "/catalogs/catalogue:default/collections/ns1:LandformTypes/items/ns1:residual-rise"
      }
    ],
    "https://prez.dev/label": [
      {
        "@value": "residual rise",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "A landform facet of very low relief (9 - 30 m) and very gentle to steep slopes. This term is used to refer to an isolated rise surrounded by other landforms.",
        "@language": "en"
      }
    ]
  },
  {
    "@id": "https://pid.geoscience.gov.au/def/voc/ga/LandformTypes/rises",
    "https://prez.dev/identifier": [
      {
        "@value": "ns1:rises"
      }
    ],
    "https://prez.dev/link": [
      {
        "@value": "/catalogs/catalogue:default/collections/ns1:LandformTypes/items/ns1:rises"
      }
    ],
    "https://prez.dev/label": [
      {
        "@value": "rises",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "A landform pattern of very low relief (9 - 30 m) and very gentle to steep slopes. Fixed erosional stream channels are closely to very widely spaced and form a dendritic to convergent, integrated or interrupted tributary pattern. The pattern is eroded by continuously active to slightly active creep and sheet flow.",
        "@language": "en"
      }
    ]
  },
