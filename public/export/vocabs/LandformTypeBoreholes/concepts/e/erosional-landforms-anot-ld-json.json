    "https://prez.dev/label": [
      {
        "@value": "drainage depression",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "A depression cut into a surface by erosional processes. This term should be used only in cases where a single  depression or valley is incised into a plateau or other surface, and where the scale of mapping does not allow\r\nthe depression to be subdivided into its component parts (e.g. rises, floodplain). ",
        "@language": "en"
      }
    ]
  },
