        "@value": "buried",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "Units that have been mapped either at the surface or in the sub-surface (e.g. using sub-bottom imagery) and have minimal surface expression (e.g. a buried FLUVIAL VALLEY visible in sub-bottom data).",
        "@language": "en"
      }
    ]
  },
