  {
    "@id": "https://pid.geoscience.gov.au/def/voc/ga/PetrophysicalProperty/koenigsbergerRatio",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@value": "Q ratio",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "The Koenigsberger ratio (Q ratio) is defined as the ratio in a rock of remanent magnetization to the induced magnetization in the Earth's field. Q = NRM (in A/m) / (K (in SI) * H (in A/m), where K is the magnetic susceptibility in SI units and H is the local geomagnetic field (generally based on the International Geomagnetic Reference Field value at the sample site and at the sampling date).",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
