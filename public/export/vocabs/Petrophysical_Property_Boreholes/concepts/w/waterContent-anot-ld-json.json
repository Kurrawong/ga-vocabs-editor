  {
    "@id": "https://pid.geoscience.gov.au/def/voc/ga/PetrophysicalProperty/boundWaterContent",
    "https://prez.dev/identifier": [
      {
        "@value": "ns1:boundWaterContent"
      }
    ],
    "https://prez.dev/link": [
      {
        "@value": "/catalogs/catalogue:default/collections/ns1:PetrophysicalProperty/items/ns1:boundWaterContent"
      }
    ],
    "https://prez.dev/label": [
      {
        "@value": "bound water content",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "Water in the pore space that does not flow under normal reservoir conditions. When used in connection with a nuclear magnetic resonance measurement, the term refers to all the water that is not free to move. This includes capillary-bound water and clay-bound water.",
        "@language": "en"
      }
    ]
  },
  {
    "@id": "https://pid.geoscience.gov.au/def/voc/ga/PetrophysicalProperty/capillaryBoundWaterContent",
    "https://prez.dev/identifier": [
      {
        "@value": "ns1:capillaryBoundWaterContent"
      }
    ],
    "https://prez.dev/link": [
      {
        "@value": "/catalogs/catalogue:default/collections/ns1:PetrophysicalProperty/items/ns1:capillaryBoundWaterContent"
      }
    ],
    "https://prez.dev/label": [
      {
        "@value": "capillary-bound water content",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "Water that is not free to move due to capillary tension. When used to describe NMR results, capillary-bound water is defined as the water signal between certain cutoffs, typically above 3 ms and below 33 ms.",
        "@language": "en"
      }
    ]
  },
  {
    "@id": "https://pid.geoscience.gov.au/def/voc/ga/PetrophysicalProperty/clayBoundWaterContent",
    "https://prez.dev/identifier": [
      {
        "@value": "ns1:clayBoundWaterContent"
      }
    ],
    "https://prez.dev/link": [
      {
        "@value": "/catalogs/catalogue:default/collections/ns1:PetrophysicalProperty/items/ns1:clayBoundWaterContent"
      }
    ],
    "https://prez.dev/label": [
      {
        "@value": "clay-bound water content",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "Water that is not free to move due to being bound to clays. When used to describe NMR results, clay-bound water is defined as the water signal below a certain cutoff, typically 3 ms.",
        "@language": "en"
      }
    ]
  },
  {
    "@id": "https://pid.geoscience.gov.au/def/voc/ga/PetrophysicalProperty/freeWaterContent",
    "https://prez.dev/identifier": [
      {
        "@value": "ns1:freeWaterContent"
      }
    ],
    "https://prez.dev/link": [
      {
        "@value": "/catalogs/catalogue:default/collections/ns1:PetrophysicalProperty/items/ns1:freeWaterContent"
      }
    ],
    "https://prez.dev/label": [
      {
        "@value": "free water content",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "Water that is mobile, available to flow, and not bound to surfaces of grains or minerals in rock. When used in connection with nuclear magnetic resonance (NMR) measurements, free water is all the water that is not clay bound, capillary bound or in mineral hydrates.",
        "@language": "en"
      }
    ]
  },
