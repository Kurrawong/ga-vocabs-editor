  {
    "@id": "https://pid.geoscience.gov.au/def/voc/ga/PetrophysicalProperty/acousticPorosity",
    "https://prez.dev/identifier": [
      {
        "@value": "ns1:acousticPorosity"
      }
    ],
    "https://prez.dev/link": [
      {
        "@value": "/catalogs/catalogue:default/collections/ns1:PetrophysicalProperty/items/ns1:acousticPorosity"
      }
    ],
    "https://prez.dev/label": [
      {
        "@value": "acoustic porosity",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "Porosity determined by acoustic logging as a function of the difference in acoustic travel time between interstitial fluids and the rock matrix",
        "@language": "en"
      }
    ]
  },
  {
    "@id": "https://pid.geoscience.gov.au/def/voc/ga/PetrophysicalProperty/apparentPorosity",
    "https://prez.dev/identifier": [
      {
        "@value": "ns1:apparentPorosity"
      }
    ],
    "https://prez.dev/link": [
      {
        "@value": "/catalogs/catalogue:default/collections/ns1:PetrophysicalProperty/items/ns1:apparentPorosity"
      }
    ],
    "https://prez.dev/label": [
      {
        "@value": "apparent porosity",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "Apparent porosity is the ratio of interconnected void spaces only, is derived determining the fluid volume of interconnecting pores and dividing by the bulk volume. This may be performed by gravimetry using water or gas pycnometry.",
        "@language": "en"
      }
    ]
  },
  {
    "@id": "https://pid.geoscience.gov.au/def/voc/ga/PetrophysicalProperty/densityPorosity",
    "https://prez.dev/identifier": [
      {
        "@value": "ns1:densityPorosity"
      }
    ],
    "https://prez.dev/link": [
      {
        "@value": "/catalogs/catalogue:default/collections/ns1:PetrophysicalProperty/items/ns1:densityPorosity"
      }
    ],
    "https://prez.dev/label": [
      {
        "@value": "density porosity",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "Density porosity is determined by emission of gamma-rays into the borehole wall and measurement of their interaction. Density porosity is then derived using other data to inform on the rock matrix density",
        "@language": "en"
      }
    ]
  },
  {
    "@id": "https://pid.geoscience.gov.au/def/voc/ga/PetrophysicalProperty/neutronPorosity",
    "https://prez.dev/identifier": [
      {
        "@value": "ns1:neutronPorosity"
      }
    ],
    "https://prez.dev/link": [
      {
        "@value": "/catalogs/catalogue:default/collections/ns1:PetrophysicalProperty/items/ns1:neutronPorosity"
      }
    ],
    "https://prez.dev/label": [
      {
        "@value": "neutron porosity",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "Neutron porosity is determined by measuring the ability of wall rocks to slow fast neutrons to the slow thermal neutron state. The number of thermal neutrons created is proportional to the amount of hydrogen present, in the form of oil or water, in pore",
        "@language": "en"
      }
    ]
  },
  {
    "@id": "https://pid.geoscience.gov.au/def/voc/ga/PetrophysicalProperty/nmrClayBoundWaterPorosity",
