<https://pid.geoscience.gov.au/def/voc/ga/protocoltype> a skos:ConceptScheme;
    skos:definition "This vocab is developed to enable the selection of Web Service protocols from a controlled list, rather than creating free text descriptions of protocols within the ISO19115-1 geospatial metadata standard.  "@en;
    skos:prefLabel "Protocol Type"@en;
    sdo:status <https://linked.data.gov.au/def/reg-statuses/experimental>;
    sdo:dateModified "2026-02-19"^^xsd:date;
    sdo:version "1.4";
    owl:versionIRI <https://pid.geoscience.gov.au/def/voc/ga/protocoltype/1.4>;
    skos:hasTopConcept <https://pid.geoscience.gov.au/def/voc/ga/protocoltype/ESRI>, <https://pid.geoscience.gov.au/def/voc/ga/protocoltype/OGC>, <https://pid.geoscience.gov.au/def/voc/ga/protocoltype/Database>, <https://pid.geoscience.gov.au/def/voc/ga/protocoltype/DataTurbine>, <https://pid.geoscience.gov.au/def/voc/ga/protocoltype/File>, <https://pid.geoscience.gov.au/def/voc/ga/protocoltype/GoogleEarth>, <https://pid.geoscience.gov.au/def/voc/ga/protocoltype/W3C>, <https://pid.geoscience.gov.au/def/voc/ga/protocoltype/JetStream>, <https://pid.geoscience.gov.au/def/voc/ga/protocoltype/UKST>;
    skos:historyNote "This codelist was introduced as part of Geoscience Australia’s extension to ISO 19115-1:2014 as per the rules of ISO 19106:2004. It constrains or extends values for elements in the GA Metadata Profile but adds no new metadata elements beyond the base standard. This protocol list was published in 2017 on the ARDC Research Vocabularies Australia. This vocab was reviewed in 2025 and published on GA's vocab register.";
    prov:qualifiedAttribution _:n3-30, _:n3-32;
