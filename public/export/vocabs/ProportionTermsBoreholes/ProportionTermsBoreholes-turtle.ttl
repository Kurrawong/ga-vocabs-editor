<https://pid.geoscience.gov.au/def/voc/ga/ProportionTerms> a skos:ConceptScheme;
    skos:definition "The proportion of an observed or sampled feature that is comprised by one or more earth materials. The vocabulary also provides approximate numeric percent ranges that correspond to the qualitative terms"@en;
    skos:prefLabel "Field Geology - Proportion Terms "@en;
    dcterms:created "2022-08-09"^^xsd:date;
    dcterms:creator <https://linked.data.gov.au/org/ga>;
    dcterms:modified "2022-08-09"^^xsd:date;
    dcterms:publisher <https://linked.data.gov.au/org/ga>;
    rdfs:seeAlso <https://pid.geoscience.gov.au/dataset/ga/148553>;
    owl:versionInfo "1";
    skos:hasTopConcept <https://pid.geoscience.gov.au/def/voc/ga/ProportionTerms/absent>, <https://pid.geoscience.gov.au/def/voc/ga/ProportionTerms/all>, <https://pid.geoscience.gov.au/def/voc/ga/ProportionTerms/present>, <https://pid.geoscience.gov.au/def/voc/ga/ProportionTerms/dominant>, <https://pid.geoscience.gov.au/def/voc/ga/ProportionTerms/major>, <https://pid.geoscience.gov.au/def/voc/ga/ProportionTerms/minor>, <https://pid.geoscience.gov.au/def/voc/ga/ProportionTerms/rare>, <https://pid.geoscience.gov.au/def/voc/ga/ProportionTerms/subordinate>, <https://pid.geoscience.gov.au/def/voc/ga/ProportionTerms/trace>, <https://pid.geoscience.gov.au/def/voc/ga/ProportionTerms/variable>;
    skos:historyNote "Geoscience Australia Proportion Terms (FGDM.LU_PROPORTION_TERMS)"@en;
