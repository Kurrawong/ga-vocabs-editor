  <rdf:Description rdf:about="https://pid.geoscience.gov.au/def/voc/ga/OnlineFunctions">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <skos:definition xml:lang="en">OnLine Function Type</skos:definition>
    <skos:prefLabel xml:lang="en">OnLine Function Type</skos:prefLabel>
    <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-07-26</dcterms:modified>
