{"@context":{"iri":"@id","prefLabel":"http://www.w3.org/2004/02/skos/core#prefLabel","altLabels":"http://www.w3.org/2004/02/skos/core#altLabel","definition":"http://www.w3.org/2004/02/skos/core#definition","notation":"http://www.w3.org/2004/02/skos/core#notation","broader":"http://www.w3.org/2004/02/skos/core#broader","scheme":"http://www.w3.org/2004/02/skos/core#inScheme","schemeLabel":"https://prez.dev/schemeLabel"},"@graph":[{"iri":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType/analyticalBlank","prefLabel":"analytical blank","definition":"An analytical procedure run without a \"substitute material\" and results obtained are considered to be the \"analytical blank\". Example 1: An acid digestion procedure is run without a sample, to show level of impurities introduced by the acids and the digestion vessels used.","scheme":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType","schemeLabel":"General Geology - Sample Type"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType/anthropogenicMaterial","prefLabel":"anthropogenic material","definition":"Anthropogenic material originating from human activity","scheme":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType","schemeLabel":"General Geology - Sample Type"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType/boreholeSpecimen","prefLabel":"borehole specimen","definition":"Any specimen of material taken from a borehole. Only used where no other information about the borehole specimen type is available.","scheme":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType","schemeLabel":"General Geology - Sample Type"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType/burnSpot","prefLabel":"burn spot","definition":"A part of a grain which is the subject of a detailed analysis via a microprobe beam of electrons or energised ions.","scheme":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType","schemeLabel":"General Geology - Sample Type"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType/catchmentOutletSpecimen","prefLabel":"catchment outlet specimen","definition":"Terrestrial sediment specimen sampled from close to the lower boundary of a hydrologic catchment; may have an aeolian component mixed in with fluvial sediments.","broader":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType/unconsolidated","scheme":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType","schemeLabel":"General Geology - Sample Type"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType/cavings","prefLabel":"cavings","definition":"Drill chips/cuttings material that is foreign to the depth interval sampled and most likely derived from higher in the stratigraphic column or possibly recirculated within the mud system from previous drilling activity.","broader":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType/drillChipsCuttings","scheme":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType","schemeLabel":"General Geology - Sample Type"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType/coastalFloatSpecimen","prefLabel":"coastal float specimen","definition":"A float specimen collected along the coastline, usually washed up on beaches. (eg, coastal bitumen).","broader":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType/floatSpecimen","scheme":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType","schemeLabel":"General Geology - Sample Type"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType/coastalSample","prefLabel":"coastal sample","definition":"A sample, usually of unconsolidated materials, collected in a coastal environment by any method. May include sediment, rocks, water, and/or organic matter. Coastal is here defined as any location above Lowest Astronomical Tide","scheme":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType","schemeLabel":"General Geology - Sample Type"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType/concentrate","prefLabel":"concentrate","definition":"A form of substance which has had the majority of its base component (in the case of a liquid: the solvent) removed. Typically this will be the removal of water from a solution or suspension","broader":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType/fraction","scheme":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType","schemeLabel":"General Geology - Sample Type"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType/core","prefLabel":"core","definition":"A specimen (often, but not always cylindrical) of rock, regolith, or vegetation.","broader":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType/boreholeSpecimen","scheme":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType","schemeLabel":"General Geology - Sample Type"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType/corePlug","prefLabel":"core plug","definition":"A small plug (cylinder) of core, typically taken from a larger rock or core sample (ie, a sub-sample)","broader":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType/core","scheme":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType","schemeLabel":"General Geology - Sample Type"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType/coreSlice","prefLabel":"core slice","definition":"A section of core that represents a specified depth interval, typically cut from a larger core specimen.","broader":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType/core","scheme":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType","schemeLabel":"General Geology - Sample Type"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType/crush","prefLabel":"crush","definition":"A coarse crushed sample.","scheme":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType","schemeLabel":"General Geology - Sample Type"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType/downholeReservoirFluidSample","prefLabel":"downhole reservoir fluid sample","definition":"A fluid sample retrieved from a downhole formation test (WFT)","scheme":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType","schemeLabel":"General Geology - Sample Type"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType/drillChipsCuttings","prefLabel":"drill chips or cuttings","altLabels":["chips","cuttings"],"definition":"Rock or sediment chips or fragments derived from any drilling method.","broader":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType/boreholeSpecimen","scheme":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType","schemeLabel":"General Geology - Sample Type"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType/drillingFluidSpecimen","prefLabel":"drilling fluid specimen","definition":"Fluid used for drill bit lubrication and return of ground rock material from the drill bit, e.g. drilling mud.","broader":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType/boreholeSpecimen","scheme":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType","schemeLabel":"General Geology - Sample Type"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType/fieldSiteObservation","prefLabel":"field site observation","definition":"An observation made of a field site (eg, an outcrop), without collection of a physical specimen.","broader":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType/fieldSiteObservation","scheme":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType","schemeLabel":"General Geology - Sample Type"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType/fieldSiteSpecimen","prefLabel":"field site specimen","definition":"Any specimen of material taken from a field site (eg, rock, sediment, water, hydrocarbon). This generic value is only used where no other information about the specimen type is available.","scheme":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType","schemeLabel":"General Geology - Sample Type"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType/filteredWaterColumnSpecimen","prefLabel":"filtered water column specimen","definition":"A water column specimen filtered for suspended solids.","broader":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType/waterColumnSpecimen","scheme":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType","schemeLabel":"General Geology - Sample Type"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType/floatSpecimen","prefLabel":"float specimen","definition":"A specimen taken of an isolated fragment or rock or other consolidated earth material, displaced from its original outcrop or location.","broader":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType/rockPieces","scheme":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType","schemeLabel":"General Geology - Sample Type"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType/fluidInclusion","prefLabel":"fluid inclusion","definition":"A fluid-filled inclusion in a rock or mineral (may also contain vapour and solids at room temperature).","scheme":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType","schemeLabel":"General Geology - Sample Type"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType/fuildMeltInclusionSection","prefLabel":"fluid or melt inclusion section","definition":"A thick section used to examine tiny inclusions of liquid, vapour, solid, or mixtures of these phases, trapped as impurities within mineral grains.","scheme":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType","schemeLabel":"General Geology - Sample Type"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType/fossil","prefLabel":"fossil","definition":"A specimen of remains or traces of a plant or animal preserved in the Earth's crust.","scheme":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType","schemeLabel":"General Geology - Sample Type"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType/fraction","prefLabel":"fraction","definition":"A specimen that has been modified to be a specific fraction separated from the original sample eg. a panned or separated sample.","scheme":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType","schemeLabel":"General Geology - Sample Type"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType/gasSpecimen","prefLabel":"gas specimen","definition":"A generic specimen of gas of any type. Includes gas specimen types collected by any method.","scheme":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType","schemeLabel":"General Geology - Sample Type"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType/grainsizeFraction","prefLabel":"grainsize fraction","definition":"A specimen that has been generated by separating various size fractions from the original sample. For example, a sieved sediment sample.","broader":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType/fraction","scheme":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType","schemeLabel":"General Geology - Sample Type"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType/gravel","prefLabel":"gravel","definition":"A specimen of unconsolidated gravel size regolith material.","broader":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType/unconsolidated","scheme":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType","schemeLabel":"General Geology - Sample Type"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType/halfCore","prefLabel":"half core","definition":"A cylindrical drill core which has been cut in half parallel to its length.","broader":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType/core","scheme":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType","schemeLabel":"General Geology - Sample Type"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType/incubationWaterSpecimen","prefLabel":"incubation water specimen","definition":"A water sample collected from a chamber or core incubation for the purpose of use of profiling the water column.","broader":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType/waterSpecimen","scheme":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType","schemeLabel":"General Geology - Sample Type"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType/isoTube","prefLabel":"IsoTube","definition":"A 110ml aluminium cylinder used to collect and store gas from a sampling manifold on a borehole druing mudgas logging. A product of ISOTECH Laboratories.","broader":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType/boreholeSpecimen","scheme":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType","schemeLabel":"General Geology - Sample Type"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType/meltInclusion","prefLabel":"melt inclusion","definition":"A glassy inclusion in a rock or mineral (may also contain liquid, vapour and crystals at room temperature).","scheme":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType","schemeLabel":"General Geology - Sample Type"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType/microfossilSlide","prefLabel":"microfossil slide","definition":"A slide prepared for microscope analysis of microfossils.","broader":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType/fossil","scheme":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType","schemeLabel":"General Geology - Sample Type"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType/mineralGrain","prefLabel":"mineral grain","definition":"An individual mineralogical particle, usually isolated from a thin section, or mounted with other grains in a polished mount.","scheme":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType","schemeLabel":"General Geology - Sample Type"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType/mineralPrecipitate","prefLabel":"mineral precipitate","definition":"A collection of one or more minerals precipitated from solution (eg, salt crust or gypsum crystals precipitated on a salt lake).","scheme":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType","schemeLabel":"General Geology - Sample Type"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType/mineralSeparate","prefLabel":"mineral separate","altLabels":["mineral concetrate"],"definition":"A collection of mineral grains separated using density and magnetic contrast from other mineral grains.","broader":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType/concentrate","scheme":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType","schemeLabel":"General Geology - Sample Type"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType/mineralSpecimen","prefLabel":"mineral specimen","definition":"A high quality or type mineral specimen, collected for scientific or display purposes in a museum or similar setting","scheme":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType","schemeLabel":"General Geology - Sample Type"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType/observationLog","prefLabel":"observation log","altLabels":["borehole observation log","measured section log"],"definition":"A description of a sampling feature in a continuous linear format (e.g. stratigraphic or lithology logs for boreholes and measured sections), where the observation description is not related to a specific collected specimen ","broader":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType/fieldSiteObservation","scheme":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType","schemeLabel":"General Geology - Sample Type"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType/observationOnly","prefLabel":"observation only","definition":"An observation made of a feature, without collection of a physical specimen.","scheme":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType","schemeLabel":"General Geology - Sample Type"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType/orientedCore","prefLabel":"oriented core","definition":"A drill core specimen taken with its orientation preserved to enable structural or other oriented analysis.","broader":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType/core","scheme":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType","schemeLabel":"General Geology - Sample Type"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType/orientedOutcropSpecimen","prefLabel":"oriented outcrop specimen","altLabels":["oriented hand specimen"],"definition":"An outcrop specimen taken with its orientation preserved to enable structural or geophysical analysis.","broader":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType/outcropSpecimen","scheme":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType","schemeLabel":"General Geology - Sample Type"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType/outcropSpecimen","prefLabel":"outcrop specimen","altLabels":["hand specimen"],"definition":"A specimen of material removed from outcropping or near-outcropping bedrock. Includes subterranean rock outcrops (ie, from a mine).","broader":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType/rockPieces","scheme":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType","schemeLabel":"General Geology - Sample Type"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType/pellet","prefLabel":"pellet","definition":"A specimen that has been ground into a powder and pressed into a pellet.","scheme":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType","schemeLabel":"General Geology - Sample Type"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType/photography","prefLabel":"photograph","definition":"A digital or film photographic still image","scheme":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType","schemeLabel":"General Geology - Sample Type"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType/polishedMount","prefLabel":"polished mount","definition":"Materials mounted in a medium, typically an epoxy glue or resin, and polished.","scheme":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType","schemeLabel":"General Geology - Sample Type"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType/polishedSlab","prefLabel":"polished slab","definition":"A polished slab of rock material.","scheme":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType","schemeLabel":"General Geology - Sample Type"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType/polishedThinSection","prefLabel":"polished thin section","definition":"A polished thin section of a material for microscope analysis.","broader":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType/thinSection","scheme":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType","schemeLabel":"General Geology - Sample Type"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType/powder","prefLabel":"powder","definition":"A specimen that has been ground into a powder.","scheme":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType","schemeLabel":"General Geology - Sample Type"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType/powderTungstenMill","prefLabel":"powder (tungsten mill)","definition":"A specimen that has been ground into a powder in a tungsten alloy mill.","scheme":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType","schemeLabel":"General Geology - Sample Type"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType/quarterCore","prefLabel":"quarter core","definition":"A cylindrical drill core which has been cut in quarters parallel to its length.","broader":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType/core","scheme":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType","schemeLabel":"General Geology - Sample Type"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType/replicateFieldSpecimen","prefLabel":"replicate field specimen","definition":"Repeat specimen taken in the field over given space and/or time scales to test field heterogeneity of a sampling medium.  Should be related to a previous original specimen.","broader":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType/replicateSpecimen","scheme":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType","schemeLabel":"General Geology - Sample Type"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType/replicateLaboratorySpecimen","prefLabel":"replicate laboratory specimen","definition":"Identical split(s) of an original sample submitted blindly to the laboratory to test reproducibility (bias) of results.  Should be related to a previous original specimen.","broader":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType/replicateSpecimen","scheme":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType","schemeLabel":"General Geology - Sample Type"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType/replicateSpecimen","prefLabel":"replicate specimen","definition":"A repeat analytical specimen designed to replicate the original specimen type and method of sample preparation and/or collection. Should be related to a previous original specimen.","scheme":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType","schemeLabel":"General Geology - Sample Type"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType/residue","prefLabel":"residue","definition":"An unspecified residue from a sample preparation or analytical technique.","scheme":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType","schemeLabel":"General Geology - Sample Type"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType/rockChips","prefLabel":"rock chips","definition":"Rock fragments derived from crushing or chipping material other than by drilling (eg, chips from an outcrop or mine channel sampling).","broader":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType/rockPieces","scheme":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType","schemeLabel":"General Geology - Sample Type"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType/rockPieces","prefLabel":"rock pieces","definition":"Unspecified rock samples or fragments of rock of unknown origin.","scheme":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType","schemeLabel":"General Geology - Sample Type"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType/seabeadSample","prefLabel":"seabed sample","definition":"A sample, usually of unconsolidated materials, collected on the seabed by any method. May include sediment, rocks, water, and/or organic matter. Seabed is here defined as any location below Lowest Astronomical Tide","scheme":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType","schemeLabel":"General Geology - Sample Type"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType/seabedSubsample","prefLabel":"seabed subsample","definition":"Specimens of surficial seafloor sediments obtained by sub-sampling the contents of a grab or box core. Depending on the intended analyses, these may be volumetric, gravimetric or qualitative.","broader":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType/seabeadSample","scheme":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType","schemeLabel":"General Geology - Sample Type"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType/separatorFluid","prefLabel":"separator fluid","definition":"Liquid that has been separated from a gas phase at a surface separator.","broader":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType/fraction","scheme":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType","schemeLabel":"General Geology - Sample Type"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType/separatorGas","prefLabel":"separator gas","definition":"Natural gas that has been separated from a liquid phase at a surface separator.","broader":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType/fraction","scheme":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType","schemeLabel":"General Geology - Sample Type"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType/sievedSample","prefLabel":"sieved sample","definition":"A grainsize fraction specimen generated by sieving","broader":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType/grainsizeFraction","scheme":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType","schemeLabel":"General Geology - Sample Type"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType/soilSpecimen","prefLabel":"soil specimen","definition":"A specimen of soil or similar regolith materials, collected by any method.","broader":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType/unconsolidated","scheme":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType","schemeLabel":"General Geology - Sample Type"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType/specimenBlank","prefLabel":"specimen blank","altLabels":["sample blank"],"definition":"A specimen blank is used to determine if any impurities are introduced during sample preparation procedures. A \"sample blank material\" substitutes regular \"sample material\" in the procedure. Example 1: Quartz substitutes a rock sample to determine levels of impurities introduced by grinding equipment. Example 2: Cellulose substitutes vegetable material to determine levels of impurities introduced during sample preparation. Example 3: Pure deionized water is substituted for sample water to determine if impurities are introduced during sample filtering and bottling procedures.","scheme":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType","schemeLabel":"General Geology - Sample Type"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType/strainedSample","prefLabel":"stained sample","definition":"A specimen, often a rock slab, that has been stained for mineral idenification.","scheme":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType","schemeLabel":"General Geology - Sample Type"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType/standardReferenceMaterial","prefLabel":"standard reference material","definition":"Also known as SRM,  these samples may range from International Standards and Certified Reference Materials (CRMs) to locally prepared standard samples for use as project reference standards. They are comprised of homogenous material prepared under strict guidelines, divided into numerous aliquots and sent to reputable laboratories to derive an assigned value. The values for Standard Reference Materials are generally well known published figures. SRMs with certified values are used to calibrate instruments or analytical techniques, to quantify analytical accuracy, and to verify new or improved analytical techniques. The material of the reference standard (eg, rock, mineral, water, etc) should be denoted in \"material type\".","scheme":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType","schemeLabel":"General Geology - Sample Type"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType/streamSedimentSpecimen","prefLabel":"stream sediment specimen","definition":"A sample of sediment taken from the bed of a river or stream.","broader":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType/unconsolidated","scheme":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType","schemeLabel":"General Geology - Sample Type"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType/thinSection","prefLabel":"thin section","definition":"A translucent thin section of a material for microscope analysis.","scheme":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType","schemeLabel":"General Geology - Sample Type"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType/thinSectionOffcut","prefLabel":"thin section offcut","definition":"A small slab of rock remaining from the preparation of a thin section.","broader":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType/rockPieces","scheme":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType","schemeLabel":"General Geology - Sample Type"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType/unconsolidated","prefLabel":"unconsolidated surficial specimen","definition":"A specimen of unconsolidated materials (eg, regolith, sediment, gravel, soil) collected by any method at or near the ground surface, including soil and organic matter.","scheme":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType","schemeLabel":"General Geology - Sample Type"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType/unknown","prefLabel":"unknown","definition":"The sample type is unknown","scheme":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType","schemeLabel":"General Geology - Sample Type"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType/vegetationSpecimen","prefLabel":"vegetation specimen","definition":"A specimen of vegetation collected by any method.","scheme":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType","schemeLabel":"General Geology - Sample Type"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType/video","prefLabel":"video","definition":"A digital or film capture of a sequence of still images representing scenes in motion","scheme":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType","schemeLabel":"General Geology - Sample Type"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType/vitriniteReflectanceSpecimen","prefLabel":"vitrinite reflectance specimen","definition":"A polished slab, mount, or slide for analysing vitrinite reflectance.","scheme":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType","schemeLabel":"General Geology - Sample Type"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType/waterColumnObservation","prefLabel":"water column observation","definition":"An observation or measurement of the water column recorded by a sonde/probe, typically taken at measured intervals used to profile the water column. No actual specimen is collected but the observation records the water conditions at a particular time and place.","broader":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType/fieldSiteObservation","scheme":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType","schemeLabel":"General Geology - Sample Type"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType/waterColumnSpecimen","prefLabel":"water column specimen","definition":"A water specimen taken at measured intervals in the water column. ","broader":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType/waterSpecimen","scheme":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType","schemeLabel":"General Geology - Sample Type"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType/waterSpecimen","prefLabel":"water specimen","definition":"A generic specimen of water of any type. Includes water specimen types collected by any method.","scheme":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType","schemeLabel":"General Geology - Sample Type"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType/wirelineLog","prefLabel":"wireline log","definition":"A continuous log of measurements made by an instrument in a borehole.","broader":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType/fieldSiteObservation","scheme":"https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType","schemeLabel":"General Geology - Sample Type"}]}