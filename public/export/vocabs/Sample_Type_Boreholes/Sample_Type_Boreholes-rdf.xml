  <rdf:Description rdf:about="https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <skos:definition xml:lang="en">The form, shape, purpose, or environment of a collected specimen or observation. Where possible the sample type description is independent of the material that comprises the specimen (eg, rock, oil, sand), or the sampling method (eg, drilling, dredging), but in practice it is not always possible or convenient to completely separate these concepts from the sample type (eg, water column specimen).</skos:definition>
    <skos:prefLabel xml:lang="en">General Geology - Sample Type</skos:prefLabel>
