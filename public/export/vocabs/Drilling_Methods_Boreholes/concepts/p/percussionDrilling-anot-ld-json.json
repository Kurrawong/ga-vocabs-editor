    ],
    "https://prez.dev/label": [
      {
        "@value": "rotary hammer drilling",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "A percussion drilling method using a cutting tool powered by compressed air that creates a rapid percussion effect coupled with rotary action to drill hard rocks.",
        "@language": "en"
      }
    ]
