        "@value": "reef or rock affected beach (BGU-T)",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "A steep (reflective) BEACH fronted by exposed rock that extends seaward as an intertidal rock platform or rock flat (Short, 2006).",
        "@language": "en"
      }
    ]
  },
  {
    "@id": "https://pid.geoscience.gov.au/def/voc/ga/SeabedGeomorphologySettings/reflective",
