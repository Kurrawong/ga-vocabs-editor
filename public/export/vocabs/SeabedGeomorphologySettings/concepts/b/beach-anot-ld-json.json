        "@value": "reflective (BGU-T)",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "A relatively steep sand or gravel deposit comprising a wide and high berm, steep beachface, subtidal step and low gradient nearshore zone (Short, 1999).",
        "@language": "en"
      }
    ]
