    ],
    "https://prez.dev/label": [
      {
        "@value": "platform reef (BGU-T)",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "A flat or nearly flat area of live or dead coral REEF elevated above the surrounding seafloor and dropping off in depth abruptly on one or more sides (Harris and Baker, 2020). PLATFORM REEFS tend to grow in all directions, and can reach sea level (Maxwell, 1968), forming islands which then may form FRINGING REEF around them (Brodie and Cohn, 2021).",
        "@language": "en"
      }
    ]
  },
