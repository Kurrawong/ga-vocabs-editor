      }
    ],
    "https://prez.dev/label": [
      {
        "@value": "patch reef (BGU-T)",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "Often found nearby or within other REEF types. Characterised by isolated patches of reef that are physically separated from other reef patches by the surrounding substrate (Brodie and Cohn, 2021; Maxwell, 1968).",
        "@language": "en"
      }
    ]
