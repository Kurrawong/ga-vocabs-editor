      {
        "@value": "toe (rocky coast) (BGU-T)",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "The base of a CLIFF defined by a marked change in gradient, typically associated with deposits of rock debris or talus.",
        "@language": "en"
      }
    ]
