  {
    "@id": "https://pid.geoscience.gov.au/def/voc/ga/SeabedGeomorphologySettings/shore_platform",
    "https://prez.dev/identifier": [
      {
        "@value": "ns1:shore_platform"
      }
    ],
    "https://prez.dev/link": [
      {
        "@value": "/catalogs/catalogue:default/collections/ns1:SeabedGeomorphologySettings/items/ns1:shore_platform"
      }
    ],
    "https://prez.dev/label": [
      {
        "@value": "shore platform (BGU-T)",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "A horizontal or gently sloping rock surface located in the intertidal zone and typically extending from the base of a CLIFF. Also termed wave-cut platforms, but this term is no longer used in recognition that platforms are the product of the combined effects of mechanical, chemical and biological processes (Trenhaile, 1987).",
        "@language": "en"
      }
    ]
  },
  {
    "@id": "https://pid.geoscience.gov.au/def/voc/ga/SeabedGeomorphologySettings/stack",
    "https://prez.dev/identifier": [
      {
        "@value": "ns1:stack"
      }
    ],
    "https://prez.dev/link": [
      {
        "@value": "/catalogs/catalogue:default/collections/ns1:SeabedGeomorphologySettings/items/ns1:stack"
      }
    ],
    "https://prez.dev/label": [
      {
        "@value": "stack (BGU-T)",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "A free-standing, isolated pillar of rock located seaward of low tide line, typically formed in more resistant lithology and defining the former position of a CLIFF line.",
        "@language": "en"
      }
    ]
  },
  {
