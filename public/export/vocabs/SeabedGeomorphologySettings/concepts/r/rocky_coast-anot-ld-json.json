  {
    "@id": "https://pid.geoscience.gov.au/def/voc/ga/SeabedGeomorphologySettings",
    "https://prez.dev/identifier": [
      {
        "@value": "ns1:SeabedGeomorphologySettings"
      }
    ],
    "https://prez.dev/link": [
      {
        "@value": "/catalogs/catalogue:default/collections/ns1:SeabedGeomorphologySettings"
      }
    ],
    "https://prez.dev/label": [
      {
        "@value": "Seabed geomorphology - Part 2 Geomorphology",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "A vocabulary of GEOMORPHIC UNIT terms (Part 2) used in the two-part marine and coastal geomorphology classification scheme (International Seabed Geomorphology Mapping Working Group - ISGM-WG: Part 1 Morphology: [https://doi.org/10.5281/zenodo.4071940](https://doi.org/10.5281/zenodo.4071940); Part 2 Geomorphology: [https://doi.org/10.5281/zenodo.7804019](https://doi.org/10.5281/zenodo.7804019) to classify MORPHOLOGY FEATURES (Part 1) with their process interpretation. These UNIT terms are structured within a consistent framework design that is replicated between eleven SETTING and PROCESS categories.\n\nThis is one of four linked ISGM-WG vocabularies. Definitions in this vocabulary are subject to intermittent review and versioning. Unless otherwise stated, all definitions are derived from the Part 2 Geomorphology report (Version 1.0) [https://doi.org/10.5281/zenodo.7804019](https://doi.org/10.5281/zenodo.7804019)).",
        "@language": "en"
      }
    ],
    "https://prez.dev/members": [
      {
        "@value": "/catalogs/catalogue:default/collections/ns1:SeabedGeomorphologySettings/items"
      }
    ]
  },
  {
    "@id": "https://pid.geoscience.gov.au/def/voc/ga/SeabedGeomorphologySettings/arch",
    "https://prez.dev/identifier": [
      {
        "@value": "ns1:arch"
      }
    ],
    "https://prez.dev/link": [
      {
        "@value": "/catalogs/catalogue:default/collections/ns1:SeabedGeomorphologySettings/items/ns1:arch"
      }
    ],
    "https://prez.dev/label": [
      {
        "@value": "arch (BGU-T)",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "An erosional unit that forms a sea opening (or tunnel) through a rocky headland but with a land connection maintained, forming the roof (Woodroffe, 2002).",
        "@language": "en"
      }
    ]
  },
  {
    "@id": "https://pid.geoscience.gov.au/def/voc/ga/SeabedGeomorphologySettings/cave",
    "https://prez.dev/identifier": [
      {
        "@value": "ns1:cave"
      }
    ],
    "https://prez.dev/link": [
      {
        "@value": "/catalogs/catalogue:default/collections/ns1:SeabedGeomorphologySettings/items/ns1:cave"
      }
    ],
    "https://prez.dev/label": [
      {
        "@value": "cave (BGU-T)",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "A large erosional indentation in a CLIFF face that forms around mean high tide level. May extends tens of metres into the cliff face, particularly in less resistant lithologies such as limestone or sandstone. Typically the product of wave action.",
        "@language": "en"
      }
    ]
  },
  {
    "@id": "https://pid.geoscience.gov.au/def/voc/ga/SeabedGeomorphologySettings/cliff",
    "https://prez.dev/identifier": [
      {
        "@value": "ns1:cliff"
      }
    ],
    "https://prez.dev/link": [
      {
        "@value": "/catalogs/catalogue:default/collections/ns1:SeabedGeomorphologySettings/items/ns1:cliff"
      }
    ],
    "https://prez.dev/label": [
      {
        "@value": "cliff (BGU-T)",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "A steep slope, or ESCARPMENT formed in rock, ranging in height from tens to hundreds of metres.",
        "@language": "en"
      }
    ]
  },
  {
    "@id": "https://pid.geoscience.gov.au/def/voc/ga/SeabedGeomorphologySettings/furrow_rocky_coast",
    "https://prez.dev/identifier": [
      {
        "@value": "ns1:furrow_rocky_coast"
      }
    ],
    "https://prez.dev/link": [
      {
        "@value": "/catalogs/catalogue:default/collections/ns1:SeabedGeomorphologySettings/items/ns1:furrow_rocky_coast"
      }
    ],
    "https://prez.dev/label": [
      {
        "@value": "furrow (rocky coast) BGU-T)",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "A narrow incision across the surface of a subhorizontal SHORE PLATFORM, in some cases extending the width of the platform to low tide line (Sunamura, 1992).",
        "@language": "en"
      }
    ]
  },
  {
    "@id": "https://pid.geoscience.gov.au/def/voc/ga/SeabedGeomorphologySettings/notch",
    "https://prez.dev/identifier": [
      {
        "@value": "ns1:notch"
      }
    ],
    "https://prez.dev/link": [
      {
        "@value": "/catalogs/catalogue:default/collections/ns1:SeabedGeomorphologySettings/items/ns1:notch"
      }
    ],
    "https://prez.dev/label": [
      {
        "@value": "notch (BGU-T)",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "A shallow erosional indentation in a CLIFF face that forms around mean high tide level. More common in rocks less resistant to weathering, notably limestone (Masselink and Hughes, 2014).",
        "@language": "en"
      }
    ]
  },
  {
    "@id": "https://pid.geoscience.gov.au/def/voc/ga/SeabedGeomorphologySettings/outcrop",
    "https://prez.dev/identifier": [
      {
        "@value": "ns1:outcrop"
      }
    ],
    "https://prez.dev/link": [
      {
        "@value": "/catalogs/catalogue:default/collections/ns1:SeabedGeomorphologySettings/items/ns1:outcrop"
      }
    ],
    "https://prez.dev/label": [
      {
        "@value": "outcrop (BGU-T)",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "A general term to describe coast and seafloor that is composed of undifferentiated ROCKY OUTCROP.",
        "@language": "en"
      }
    ]
  },
  {
    "@id": "https://pid.geoscience.gov.au/def/voc/ga/SeabedGeomorphologySettings/plunging_cliff",
    "https://prez.dev/identifier": [
      {
        "@value": "ns1:plunging_cliff"
      }
    ],
    "https://prez.dev/link": [
      {
        "@value": "/catalogs/catalogue:default/collections/ns1:SeabedGeomorphologySettings/items/ns1:plunging_cliff"
      }
    ],
    "https://prez.dev/label": [
      {
        "@value": "plunging cliff (BGU-T)",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "A near-vertical slope that continues below the water line, typically greater than 100 m high and formed in resistant lithology.",
        "@language": "en"
      }
    ]
  },
  {
    "@id": "https://pid.geoscience.gov.au/def/voc/ga/SeabedGeomorphologySettings/pool",
    "https://prez.dev/identifier": [
      {
        "@value": "ns1:pool"
      }
    ],
    "https://prez.dev/link": [
      {
        "@value": "/catalogs/catalogue:default/collections/ns1:SeabedGeomorphologySettings/items/ns1:pool"
      }
    ],
    "https://prez.dev/label": [
      {
        "@value": "pool (BGU-T)",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "A shallow (< 3 m) depression formed in the intertidal zone of SHORE PLATFORM, typically resulting from solution of rock by standing water and are enclosed by small ridges (Guilcher, 1988).",
        "@language": "en"
      }
    ]
  },
  {
    "@id": "https://pid.geoscience.gov.au/def/voc/ga/SeabedGeomorphologySettings/pothole",
    "https://prez.dev/identifier": [
      {
        "@value": "ns1:pothole"
      }
    ],
    "https://prez.dev/link": [
      {
        "@value": "/catalogs/catalogue:default/collections/ns1:SeabedGeomorphologySettings/items/ns1:pothole"
      }
    ],
    "https://prez.dev/label": [
      {
        "@value": "pothole (BGU-T)",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "A deep POOL formed in the intertidal zone of a SHORE PLATFORM, typically formed by the gouging action of loose boulders (Woodroffe, 2002).",
        "@language": "en"
      }
    ]
  },
  {
    "@id": "https://pid.geoscience.gov.au/def/voc/ga/SeabedGeomorphologySettings/ramp",
    "https://prez.dev/identifier": [
      {
        "@value": "ns1:ramp"
      }
    ],
    "https://prez.dev/link": [
      {
        "@value": "/catalogs/catalogue:default/collections/ns1:SeabedGeomorphologySettings/items/ns1:ramp"
      }
    ],
    "https://prez.dev/label": [
      {
        "@value": "ramp (BGU-T)",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "A seaward sloping steeper section of a sub-horizontal SHORE PLATFORM, typically abutting the TOE of a CLIFF (Sunamura, 1992).",
        "@language": "en"
      }
    ]
  },
  {
    "@id": "https://pid.geoscience.gov.au/def/voc/ga/SeabedGeomorphologySettings/rampart",
    "https://prez.dev/identifier": [
      {
        "@value": "ns1:rampart"
      }
    ],
    "https://prez.dev/link": [
      {
        "@value": "/catalogs/catalogue:default/collections/ns1:SeabedGeomorphologySettings/items/ns1:rampart"
      }
    ],
    "https://prez.dev/label": [
      {
        "@value": "rampart (BGU-T)",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "A slightly raised edge that forms at the seaward margin of sub-horizontal SHORE PLATFORMS, possibly associated with a more resistant lithology.",
        "@language": "en"
      }
    ]
  },
