    "https://prez.dev/label": [
      {
        "@value": "bayhead (BGU-T)",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "A type of DELTA located in the landward zone of an embayment, comprising terrigenous sediment sourced from the catchment (Dalrymple et al., 1992).",
        "@language": "en"
      }
    ]
  },
