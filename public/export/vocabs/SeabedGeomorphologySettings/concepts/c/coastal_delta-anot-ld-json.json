    "https://prez.dev/label": [
      {
        "@value": "coastal delta-front (BGU-T)",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "The subaqueous portion of the delta between the subaerial delta and its associated MOUTHBARS and above wave base, where relatively coarse material is deposited (Postma, 1984; Suter, 1994).\nCf. FLUVIAL DELTA-FRONT",
        "@language": "en"
      }
    ]
  },
  {
    "@id": "https://pid.geoscience.gov.au/def/voc/ga/SeabedGeomorphologySettings/coastal_pro-delta",
