      {
        "@value": "coastal pro-delta (BGU-T)",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "The relatively low gradient, subaqueous portion of a delta below wave base, where relatively fine material is deposited.\nCf. FLUVIAL PRO-DELTA",
        "@language": "en"
      }
    ]
