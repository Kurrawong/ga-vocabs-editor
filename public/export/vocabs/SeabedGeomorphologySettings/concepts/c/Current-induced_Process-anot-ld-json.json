    "https://prez.dev/label": [
      {
        "@value": "Current-induced Process",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "A PROCESS grouping that includes a broad suite of geomorphic UNITS that are primarily formed by air and water currents by modern or former processes. Where the formative process is known (e.g. MARINE, ANTHROPOGENIC) these units can be reclassified into their formative SETTING or PROCESS (e.g. a CURRENT-INDUCED DUNE that is submerged on the continental shelf can be reclassed as a COASTAL DUNE).",
        "@language": "en"
      }
    ]
  },
  {
    "@id": "https://pid.geoscience.gov.au/def/voc/ga/SeabedGeomorphologySettings/barform",
    "https://prez.dev/identifier": [
      {
        "@value": "ns1:barform"
      }
    ],
    "https://prez.dev/link": [
      {
        "@value": "/catalogs/catalogue:default/collections/ns1:SeabedGeomorphologySettings/items/ns1:barform"
      }
    ],
    "https://prez.dev/label": [
      {
        "@value": "barform (BGU)",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "Tend to be larger than BEDFORMS (e.g. Venditti, 2013), are often forced by macro-scale topography (e.g. CHANNELS - POINTBAR; HEADLANDS - BANNER), and develop over longer periods of time (e.g. Dury, 1970).",
        "@language": "en"
      }
    ]
  },
  {
    "@id": "https://pid.geoscience.gov.au/def/voc/ga/SeabedGeomorphologySettings/bedform",
    "https://prez.dev/identifier": [
      {
        "@value": "ns1:bedform"
      }
    ],
    "https://prez.dev/link": [
      {
        "@value": "/catalogs/catalogue:default/collections/ns1:SeabedGeomorphologySettings/items/ns1:bedform"
      }
    ],
    "https://prez.dev/label": [
      {
        "@value": "bedform (BGU)",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "Quasi-rhythmic, erosional or depositional units formed at the interface between sediment and a lower-density medium (e.g. water, air, ice or pyroclastic flows). BEDFORMS constitute the bulk of sediment transport (Robert, 2014) and scale to changing flow properties (e.g. Simons and Richardson, 1966). BEDFORMS often develop over BARFORMS in response to changing flow conditions (Simons and Richardson, 1966).",
        "@language": "en"
      }
    ]
  },
  {
    "@id": "https://pid.geoscience.gov.au/def/voc/ga/SeabedGeomorphologySettings/chute_channel",
    "https://prez.dev/identifier": [
      {
        "@value": "ns1:chute_channel"
      }
    ],
    "https://prez.dev/link": [
      {
        "@value": "/catalogs/catalogue:default/collections/ns1:SeabedGeomorphologySettings/items/ns1:chute_channel"
      }
    ],
    "https://prez.dev/label": [
      {
        "@value": "chute channel (BGU)",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "A channel with typically more rapid flow that cuts through constrictive material and so short-cuts the main flow (e.g. through a BARFORM in a SUBAERIAL CHANNEL; between BARRIER ISLANDS; Goudie, 2006).",
        "@language": "en"
      }
    ]
  },
  {
    "@id": "https://pid.geoscience.gov.au/def/voc/ga/SeabedGeomorphologySettings/current-induced_channel",
    "https://prez.dev/identifier": [
      {
        "@value": "ns1:current-induced_channel"
      }
    ],
    "https://prez.dev/link": [
      {
        "@value": "/catalogs/catalogue:default/collections/ns1:SeabedGeomorphologySettings/items/ns1:current-induced_channel"
      }
    ],
    "https://prez.dev/label": [
      {
        "@value": "current-induced channel (BGU)",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "A channel of any scale that has been formed by any type of flow.",
        "@language": "en"
      }
    ]
  },
  {
    "@id": "https://pid.geoscience.gov.au/def/voc/ga/SeabedGeomorphologySettings/knickpoint",
    "https://prez.dev/identifier": [
      {
        "@value": "ns1:knickpoint"
      }
    ],
    "https://prez.dev/link": [
      {
        "@value": "/catalogs/catalogue:default/collections/ns1:SeabedGeomorphologySettings/items/ns1:knickpoint"
      }
    ],
    "https://prez.dev/label": [
      {
        "@value": "knickpoint (BGU)",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "A KNICKPOINT is a substantially steepened section of a long profile (modified from Goudie, 2006), usually measured along the thalweg or centreline of a CHANNEL, VALLEY or CANYON.",
        "@language": "en"
      }
    ]
  },
  {
    "@id": "https://pid.geoscience.gov.au/def/voc/ga/SeabedGeomorphologySettings/oxbow",
    "https://prez.dev/identifier": [
      {
        "@value": "ns1:oxbow"
      }
    ],
    "https://prez.dev/link": [
      {
        "@value": "/catalogs/catalogue:default/collections/ns1:SeabedGeomorphologySettings/items/ns1:oxbow"
      }
    ],
    "https://prez.dev/label": [
      {
        "@value": "oxbow (BGU)",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "An abandoned channel reach, typically meandering in plan view, formed as a result of channel cut-off and channel adjustment (Reineck and Singh, 2012).",
        "@language": "en"
      }
    ]
  },
  {
    "@id": "https://pid.geoscience.gov.au/def/voc/ga/SeabedGeomorphologySettings/plunge_pool",
    "https://prez.dev/identifier": [
      {
        "@value": "ns1:plunge_pool"
      }
    ],
    "https://prez.dev/link": [
      {
        "@value": "/catalogs/catalogue:default/collections/ns1:SeabedGeomorphologySettings/items/ns1:plunge_pool"
      }
    ],
    "https://prez.dev/label": [
      {
        "@value": "plunge pool (BGU)",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "Depressions situated downstream of steep reaches of SUBAERIAL and SUBMARINE CHANNELS, VALLEYS and GULLIES, and CANYONS, and downstream of escarpments where flows either excavate basement material (e.g. downstream of indurated sediment in SUBAERIAL CHANNELS or CANYONS) or maintain depth and deposit material further downstream.",
        "@language": "en"
      }
    ]
  },
