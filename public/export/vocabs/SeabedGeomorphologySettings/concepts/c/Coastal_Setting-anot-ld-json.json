    ],
    "https://prez.dev/label": [
      {
        "@value": "tidal flat (BGU)",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "Low gradient intertidal to supratidal surfaces formed in fine-grained sediment (Woodroffe, 2002).",
        "@language": "en"
      }
