      }
    ]
  },
  {
    "@id": "https://pid.geoscience.gov.au/def/voc/ga/SeabedGeomorphologySettings/back_barrier",
    "https://prez.dev/identifier": [
      {
        "@value": "ns1:back_barrier"
      }
    ],
    "https://prez.dev/link": [
      {
        "@value": "/catalogs/catalogue:default/collections/ns1:SeabedGeomorphologySettings/items/ns1:back_barrier"
      }
    ],
    "https://prez.dev/label": [
      {
        "@value": "back barrier (BGU)",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "A relatively protected area between the BARRIER and the mainland, which may be occupied by FLATS or a LAGOON (modified from Davis Jr and FitzGerald, 2009).",
        "@language": "en"
      }
    ]
  },
  {
    "@id": "https://pid.geoscience.gov.au/def/voc/ga/SeabedGeomorphologySettings/barrier",
    "https://prez.dev/identifier": [
      {
        "@value": "ns1:barrier"
      }
    ],
    "https://prez.dev/link": [
      {
        "@value": "/catalogs/catalogue:default/collections/ns1:SeabedGeomorphologySettings/items/ns1:barrier"
      }
    ],
    "https://prez.dev/label": [
      {
        "@value": "barrier (BGU)",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "Elongate accumulations of sand or coarser sediment primarily deposited by waves and longshore currents, rising above the formative sea level, often impounding terrestrial drainage or blocking off a LAGOON in the BACKBARRIER (modified from Griffin et al., 2012; Woodroffe, 2002). Can be sub-classified using their number of attachment points to the mainland (cf. SALIENT/TOMBOLO; BAY-MOUTH; SPIT).",
        "@language": "en"
      }
    ]
  },
  {
    "@id": "https://pid.geoscience.gov.au/def/voc/ga/SeabedGeomorphologySettings/barrier_complex",
    "https://prez.dev/identifier": [
      {
        "@value": "ns1:barrier_complex"
      }
    ],
    "https://prez.dev/link": [
      {
        "@value": "/catalogs/catalogue:default/collections/ns1:SeabedGeomorphologySettings/items/ns1:barrier_complex"
      }
    ],
    "https://prez.dev/label": [
      {
        "@value": "barrier complex (BGU)",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "Amalgamated, shore-parallel sand bodies incorporating BEACH, coastal dunes (DUNE - foredune BGU-sT), WASHOVER and backbarrier FLAT deposits. May comprise multiple shorelines to form a PLAIN (STRAND- or CHENIER) (modified from Griffin et al., 2012).",
        "@language": "en"
      }
    ]
  },
  {
    "@id": "https://pid.geoscience.gov.au/def/voc/ga/SeabedGeomorphologySettings/beach",
    "https://prez.dev/identifier": [
      {
        "@value": "ns1:beach"
      }
    ],
    "https://prez.dev/link": [
      {
        "@value": "/catalogs/catalogue:default/collections/ns1:SeabedGeomorphologySettings/items/ns1:beach"
      }
    ],
    "https://prez.dev/label": [
      {
        "@value": "beach (BGU)",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "A wave-deposited body of sand or gravel formed along open coast (marine), estuarine and lacustrine shorelines.",
        "@language": "en"
      }
    ]
  },
  {
    "@id": "https://pid.geoscience.gov.au/def/voc/ga/SeabedGeomorphologySettings/beach_ridge",
    "https://prez.dev/identifier": [
      {
        "@value": "ns1:beach_ridge"
      }
    ],
    "https://prez.dev/link": [
      {
        "@value": "/catalogs/catalogue:default/collections/ns1:SeabedGeomorphologySettings/items/ns1:beach_ridge"
      }
    ],
    "https://prez.dev/label": [
      {
        "@value": "beach ridge (BGU)",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "Relict ridges of wave origin, sub to parallel to the open coastline, possibly including wind deposits that collectively form STRANDPLAINS. Active BEACH and shore ridge forms (cf. CURRENT-INDUCED PROCESSES: DUNES –foredune BGU-sT), regardless of their dimensions, shape or origin, are not considered to be BEACH RIDGES by most authors (e.g. Otvos, 2020, modified from 2000).",
        "@language": "en"
      }
    ]
  },
  {
    "@id": "https://pid.geoscience.gov.au/def/voc/ga/SeabedGeomorphologySettings/beachface",
    "https://prez.dev/identifier": [
      {
        "@value": "ns1:beachface"
      }
    ],
    "https://prez.dev/link": [
      {
        "@value": "/catalogs/catalogue:default/collections/ns1:SeabedGeomorphologySettings/items/ns1:beachface"
      }
    ],
    "https://prez.dev/label": [
      {
        "@value": "beachface (BGU)",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "The coastal area between the low-tide shoreline (SHOREFACE) and the maximum height of wave effect.",
        "@language": "en"
      }
    ]
  },
  {
    "@id": "https://pid.geoscience.gov.au/def/voc/ga/SeabedGeomorphologySettings/channel_belt",
    "https://prez.dev/identifier": [
      {
        "@value": "ns1:channel_belt"
      }
    ],
    "https://prez.dev/link": [
      {
        "@value": "/catalogs/catalogue:default/collections/ns1:SeabedGeomorphologySettings/items/ns1:channel_belt"
      }
    ],
    "https://prez.dev/label": [
      {
        "@value": "channel belt (BGU)",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "A conglomeration of relatively coarser-grained sediment comprised of amalgamated SUBAERIAL CHANNEL, BEDFORM and BARFORM deposits (modified from Bridge and Tye, 2000; cf. Marine SUBMARINE CHANNEL BELT versus Fluvial CHANNEL BELT geometries: Jobe et al., 2016).",
        "@language": "en"
      }
    ]
  },
  {
    "@id": "https://pid.geoscience.gov.au/def/voc/ga/SeabedGeomorphologySettings/channel_ledge",
    "https://prez.dev/identifier": [
      {
        "@value": "ns1:channel_ledge"
      }
    ],
    "https://prez.dev/link": [
      {
        "@value": "/catalogs/catalogue:default/collections/ns1:SeabedGeomorphologySettings/items/ns1:channel_ledge"
      }
    ],
    "https://prez.dev/label": [
      {
        "@value": "channel ledge (BGU)",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "Distinctly stepped, flat-topped, elongate, bank-attached units. Have straight to gently curved planforms and flank one or both banks. Composed of the same materials as the adjacent FLOODPLAIN (i.e. sediments are laterally continuous from the CHANNEL LEDGE into their adjacent FLOODPLAIN) and are formed by channel expansion processes where flows selectively erode the upper units of the adjacent surface as the channel incises and expands (Brierley and Fryirs, 2013).",
        "@language": "en"
      }
    ]
  },
  {
    "@id": "https://pid.geoscience.gov.au/def/voc/ga/SeabedGeomorphologySettings/chenier_ridge",
    "https://prez.dev/identifier": [
      {
        "@value": "ns1:chenier_ridge"
      }
    ],
    "https://prez.dev/link": [
      {
        "@value": "/catalogs/catalogue:default/collections/ns1:SeabedGeomorphologySettings/items/ns1:chenier_ridge"
      }
    ],
    "https://prez.dev/label": [
      {
        "@value": "chenier ridge (BGU)",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "Sandy or shelly elongate RIDGES (MORPHOLOGY), differentiated from other sand or shell BEACH RIDGES by the fact that they are perched over fine grained, muddy (or sometimes marshy) sediments and are separated from one another by these finer-grained deposits (modified from Goudie, 2006).",
        "@language": "en"
      }
    ]
  },
  {
    "@id": "https://pid.geoscience.gov.au/def/voc/ga/SeabedGeomorphologySettings/coastal_barform",
    "https://prez.dev/identifier": [
      {
        "@value": "ns1:coastal_barform"
      }
    ],
    "https://prez.dev/link": [
      {
        "@value": "/catalogs/catalogue:default/collections/ns1:SeabedGeomorphologySettings/items/ns1:coastal_barform"
      }
    ],
    "https://prez.dev/label": [
      {
        "@value": "coastal barform (BGU)",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "Any type of BARFORM formed in a COASTAL SETTING; the exact BGU-T or BGU-sT may be unknown or may exceed classification requirements.",
        "@language": "en"
      }
    ]
  },
  {
    "@id": "https://pid.geoscience.gov.au/def/voc/ga/SeabedGeomorphologySettings/coastal_delta",
    "https://prez.dev/identifier": [
      {
        "@value": "ns1:coastal_delta"
      }
    ],
    "https://prez.dev/link": [
      {
        "@value": "/catalogs/catalogue:default/collections/ns1:SeabedGeomorphologySettings/items/ns1:coastal_delta"
      }
    ],
    "https://prez.dev/label": [
      {
        "@value": "coastal delta (BGU)",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "A discrete shoreline sedimentary protuberance formed where a river enters a body of water and supplies sediment more rapidly than it can be redistributed by basinal processes (modified from: Elliott, 1986).\nCf. FLUVIAL DELTA",
        "@language": "en"
      }
    ]
  },
  {
    "@id": "https://pid.geoscience.gov.au/def/voc/ga/SeabedGeomorphologySettings/coastal_subaerial_valley",
    "https://prez.dev/identifier": [
      {
        "@value": "ns1:coastal_subaerial_valley"
      }
    ],
    "https://prez.dev/link": [
      {
        "@value": "/catalogs/catalogue:default/collections/ns1:SeabedGeomorphologySettings/items/ns1:coastal_subaerial_valley"
      }
    ],
    "https://prez.dev/label": [
      {
        "@value": "coastal subaerial valley (BGU)",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "Form via combinations of fluvial and coastal processes (see Additional Attributes: Marginal marine process classification); they widen by lateral SUBAERIAL CHANNEL erosion and weathering, and lengthen by both headward erosion and progradation in their lower reaches. SUBAERIAL VALLEYS can form networks with a variety of drainage patterns (see DRAINAGE NETWORK; modified from Goudie, 2006). Cf. RIVER VALLEY; INCISED VALLEY; RIA; FJORD.\nCf. FLUVIAL SUBAERIAL VALLEY",
        "@language": "en"
      }
    ]
  },
  {
    "@id": "https://pid.geoscience.gov.au/def/voc/ga/SeabedGeomorphologySettings/delta_lobe",
    "https://prez.dev/identifier": [
      {
        "@value": "ns1:delta_lobe"
      }
    ],
    "https://prez.dev/link": [
      {
        "@value": "/catalogs/catalogue:default/collections/ns1:SeabedGeomorphologySettings/items/ns1:delta_lobe"
      }
    ],
    "https://prez.dev/label": [
      {
        "@value": "delta lobe (BGU)",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "Discrete accumulations of sediment that form at the distal end of relatively confined river channels and may represent distinct avulsion events (Chatanantavet et al., 2012). Multiple DELTA LOBES sum to comprise entire DELTAS.",
        "@language": "en"
      }
    ]
  },
  {
    "@id": "https://pid.geoscience.gov.au/def/voc/ga/SeabedGeomorphologySettings/floodplain",
    "https://prez.dev/identifier": [
      {
        "@value": "ns1:floodplain"
      }
    ],
    "https://prez.dev/link": [
      {
        "@value": "/catalogs/catalogue:default/collections/ns1:SeabedGeomorphologySettings/items/ns1:floodplain"
      }
    ],
    "https://prez.dev/label": [
      {
        "@value": "floodplain (BGU)",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "The relatively flat area of land between the banks of the parent stream and the confining valley walls, over which water from the parent stream flows at times of high discharge. The sediment that comprises a FLOODPLAIN is mainly alluvium derived from the parent stream (modified from Goudie, 2006) and can be comprised of confined/cut-and-fill, braided, lateral migration or anabranching floodplain deposits (Nanson and Croke, 1992).",
        "@language": "en"
      }
    ]
  },
  {
    "@id": "https://pid.geoscience.gov.au/def/voc/ga/SeabedGeomorphologySettings/floodplain_terrace",
    "https://prez.dev/identifier": [
      {
        "@value": "ns1:floodplain_terrace"
      }
    ],
    "https://prez.dev/link": [
      {
        "@value": "/catalogs/catalogue:default/collections/ns1:SeabedGeomorphologySettings/items/ns1:floodplain_terrace"
      }
    ],
    "https://prez.dev/label": [
      {
        "@value": "floodplain terrace (BGU)",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "Planar-surfaced units that remain after the adjacent channel has incised and abandoned the surface (Brierley and Fryirs, 2013) and can be comprised of alluvial material (cf. FLOODPLAINS) or rock (cf. STRATH; modified from Goudie, 2006).",
        "@language": "en"
      }
    ]
  },
  {
    "@id": "https://pid.geoscience.gov.au/def/voc/ga/SeabedGeomorphologySettings/lagoon",
    "https://prez.dev/identifier": [
      {
        "@value": "ns1:lagoon"
      }
    ],
    "https://prez.dev/link": [
      {
        "@value": "/catalogs/catalogue:default/collections/ns1:SeabedGeomorphologySettings/items/ns1:lagoon"
      }
    ],
    "https://prez.dev/label": [
      {
        "@value": "lagoon (BGU)",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "A stretch of usually saline water separated from the sea by a low BARRIER or coral REEF (Cf. REEF LAGOON - Biogenic; Goudie, 2006).",
        "@language": "en"
      }
    ]
  },
  {
    "@id": "https://pid.geoscience.gov.au/def/voc/ga/SeabedGeomorphologySettings/raised_beach",
    "https://prez.dev/identifier": [
      {
        "@value": "ns1:raised_beach"
      }
    ],
    "https://prez.dev/link": [
      {
        "@value": "/catalogs/catalogue:default/collections/ns1:SeabedGeomorphologySettings/items/ns1:raised_beach"
      }
    ],
    "https://prez.dev/label": [
      {
        "@value": "raised beach (BGU)",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "A relict landform comprising mostly wave-transported sedimentary material preserved above and landward of the active shoreline. RAISED BEACHES are distinguished here from raised SHOREFACE TERRACES on the basis that the former are solely the product of physical depositional mechanisms, whereas the latter have a broader genesis that may incorporate depositional, erosional and/or BIOGENIC PROCESSES (modified from Goudie, 2006).",
        "@language": "en"
      }
    ]
  },
  {
    "@id": "https://pid.geoscience.gov.au/def/voc/ga/SeabedGeomorphologySettings/rocky_coast",
    "https://prez.dev/identifier": [
      {
        "@value": "ns1:rocky_coast"
      }
    ],
    "https://prez.dev/link": [
      {
        "@value": "/catalogs/catalogue:default/collections/ns1:SeabedGeomorphologySettings/items/ns1:rocky_coast"
      }
    ],
    "https://prez.dev/label": [
      {
        "@value": "rocky coast (BGU)",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "Any length of coast that is predominantly characterised by rock (rather than sediment or vegetation).",
        "@language": "en"
      }
    ]
  },
  {
    "@id": "https://pid.geoscience.gov.au/def/voc/ga/SeabedGeomorphologySettings/shoreface",
    "https://prez.dev/identifier": [
      {
        "@value": "ns1:shoreface"
      }
    ],
    "https://prez.dev/link": [
      {
        "@value": "/catalogs/catalogue:default/collections/ns1:SeabedGeomorphologySettings/items/ns1:shoreface"
      }
    ],
    "https://prez.dev/label": [
      {
        "@value": "shoreface (BGU)",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "The relatively steep surface between the low-tide shoreline and the inner shelf. The lower boundary of the SHOREFACE commences where ocean swell waves begin to shoal towards the shore (modified from Boak and Turner, 2005; Woodroffe, 2002).",
        "@language": "en"
      }
    ]
  },
  {
    "@id": "https://pid.geoscience.gov.au/def/voc/ga/SeabedGeomorphologySettings/subaerial_channel",
    "https://prez.dev/identifier": [
      {
        "@value": "ns1:subaerial_channel"
      }
    ],
    "https://prez.dev/link": [
      {
        "@value": "/catalogs/catalogue:default/collections/ns1:SeabedGeomorphologySettings/items/ns1:subaerial_channel"
      }
    ],
    "https://prez.dev/label": [
      {
        "@value": "subaerial channel (BGU)",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "Formed of alluvium, usually have mobile boundaries and are self-adjusting in response to changing conditions. Commonly parabolic or trapezoid in cross section with adjacent, roughly horizontal FLOODPLAINS that are inundated when the channel exceeds bankfull capacity (modified from Goudie, 2006).",
        "@language": "en"
      }
    ]
  },
  {
    "@id": "https://pid.geoscience.gov.au/def/voc/ga/SeabedGeomorphologySettings/tidal_flat",
