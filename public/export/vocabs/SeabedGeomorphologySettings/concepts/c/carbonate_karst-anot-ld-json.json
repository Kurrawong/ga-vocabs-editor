      }
    ],
    "https://prez.dev/label": [
      {
        "@value": "carbonate doline (BGU-T)",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "Funnel-shaped (dissolution) or steep-sided (collapse) subcircular closed surface depression in a carbonate karst terrain; also called sinkhole.",
        "@language": "en"
      }
    ]
  },
