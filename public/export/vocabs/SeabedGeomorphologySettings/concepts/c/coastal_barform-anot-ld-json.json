  {
    "@id": "https://pid.geoscience.gov.au/def/voc/ga/SeabedGeomorphologySettings/intertidal_bar",
    "https://prez.dev/identifier": [
      {
        "@value": "ns1:intertidal_bar"
      }
    ],
    "https://prez.dev/link": [
      {
        "@value": "/catalogs/catalogue:default/collections/ns1:SeabedGeomorphologySettings/items/ns1:intertidal_bar"
      }
    ],
    "https://prez.dev/label": [
      {
        "@value": "intertidal bar (BGU-T)",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "A low gradient sand bar that forms in the intertidal zone of BEACHES. On macrotidal coasts, multiple bars typically form into a RIDGE AND RUNNEL system (Masselink and Hughes, 2014).",
        "@language": "en"
      }
    ]
  },
  {
    "@id": "https://pid.geoscience.gov.au/def/voc/ga/SeabedGeomorphologySettings/nearshore_bar",
    "https://prez.dev/identifier": [
      {
        "@value": "ns1:nearshore_bar"
      }
    ],
    "https://prez.dev/link": [
      {
        "@value": "/catalogs/catalogue:default/collections/ns1:SeabedGeomorphologySettings/items/ns1:nearshore_bar"
      }
    ],
    "https://prez.dev/label": [
      {
        "@value": "nearshore bar (BGU-T)",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "A deposit of sand or gravel that forms in the nearshore (subtidal) zone of a BEACH. Variable in planform, ranging from straight to cresentic to transverse (oblique to shoreline). May be continuous alongshore or discontinuous with rip channels separating adjacent bars (Short, 1999).",
        "@language": "en"
      }
    ]
  },
  {
    "@id": "https://pid.geoscience.gov.au/def/voc/ga/SeabedGeomorphologySettings/ridge_and_runnel",
    "https://prez.dev/identifier": [
      {
        "@value": "ns1:ridge_and_runnel"
      }
    ],
    "https://prez.dev/link": [
      {
        "@value": "/catalogs/catalogue:default/collections/ns1:SeabedGeomorphologySettings/items/ns1:ridge_and_runnel"
      }
    ],
    "https://prez.dev/label": [
      {
        "@value": "ridge and runnel (BGU-T)",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "A low gradient sand bar and trough that forms alongshore in the intertidal zone of a BEACH. On macrotidal beaches, multiple ridges (Cf. INTERTIDAL BARS) and runnels may form across the intertidal zone spanning tens to hundreds of metres (Masselink and Hughes, 2014).",
        "@language": "en"
      }
    ]
  },
  {
    "@id": "https://pid.geoscience.gov.au/def/voc/ga/SeabedGeomorphologySettings/shoreface_terrace",
    "https://prez.dev/identifier": [
      {
        "@value": "ns1:shoreface_terrace"
      }
    ],
    "https://prez.dev/link": [
      {
        "@value": "/catalogs/catalogue:default/collections/ns1:SeabedGeomorphologySettings/items/ns1:shoreface_terrace"
      }
    ],
    "https://prez.dev/label": [
      {
        "@value": "shoreface terrace (BGU-T)",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "SHOREFACE TERRACES are formed by subaerial weathering during lowstand exposure and wave erosion that drove the coastline landward during subsequent sea-level rise (Micallef et al., 2017).\nCf. RAISED BEACH",
        "@language": "en"
      }
    ]
  },
  {
    "@id": "https://pid.geoscience.gov.au/def/voc/ga/SeabedGeomorphologySettings/tidal_bar",
    "https://prez.dev/identifier": [
      {
        "@value": "ns1:tidal_bar"
      }
    ],
    "https://prez.dev/link": [
      {
        "@value": "/catalogs/catalogue:default/collections/ns1:SeabedGeomorphologySettings/items/ns1:tidal_bar"
      }
    ],
    "https://prez.dev/label": [
      {
        "@value": "tidal bar (BGU-T)",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "Discontinuous COASTAL BARS that typically form in tide-dominated SUBAERIAL CHANNELS, which are aligned to the dominant flow direction (Dalrymple et al., 1992).",
        "@language": "en"
      }
    ]
  },
  {
    "@id": "https://pid.geoscience.gov.au/def/voc/ga/SeabedGeomorphologySettings/washover_bar",
    "https://prez.dev/identifier": [
      {
        "@value": "ns1:washover_bar"
      }
    ],
    "https://prez.dev/link": [
      {
        "@value": "/catalogs/catalogue:default/collections/ns1:SeabedGeomorphologySettings/items/ns1:washover_bar"
      }
    ],
    "https://prez.dev/label": [
      {
        "@value": "washover bar (BGU-T)",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "A low gradient sandy to gravelly deposit located on the landward side of a BARRIER deposited over a BACK-BARRIER FLAT or LAGOON facies, formed by storm surge or tsunami run-up. Typically fan shaped in plan view (Reineck and Singh, 2012).",
        "@language": "en"
      }
    ]
  },
