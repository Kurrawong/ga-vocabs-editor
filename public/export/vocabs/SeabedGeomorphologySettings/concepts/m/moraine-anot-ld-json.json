    ],
    "https://prez.dev/description": [
      {
        "@value": "<I>An end moraine formed by the ‘bulldozing’ of sediment by an advancing ice front</I> (Excerpt from Bell et al. 2016, adapted from Bell et al. 1997. In: Dowdeswell et al., 2016).",
        "@language": "en"
      }
    ]
  },
