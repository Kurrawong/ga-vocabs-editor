      {
        "@value": "shear-margin moraine (BGU-T)",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "<I>Elongate ridges found on the edges of shallow banks at CROSS-SHELF TROUGH lateral margins, formed subglacially at ice-stream shear zones with surrounding slower-moving ice</I> (Excerpt from Bell et al. 2016, adapted from Bell et al. 1997. In: Dowdeswell et al., 2016).",
        "@language": "en"
