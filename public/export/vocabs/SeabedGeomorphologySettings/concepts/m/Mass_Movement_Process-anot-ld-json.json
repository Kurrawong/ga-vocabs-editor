      {
        "@value": "ns1:remnant_block"
      }
    ],
    "https://prez.dev/link": [
      {
        "@value": "/catalogs/catalogue:default/collections/ns1:SeabedGeomorphologySettings/items/ns1:remnant_block"
      }
    ],
    "https://prez.dev/label": [
      {
        "@value": "remnant block (BGU)",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "A Block of undisturbed, coherent sediment, found within the remobilised material but which has not been displaced during the mass movement. This type of in situ block can be recognised in seismic profiles by the contrast between areas of lateral concordant and continuous seismic facies and the often chaotic facies of the remoulded material.",
        "@language": "en"
      }
    ]
  },
  {
    "@id": "https://pid.geoscience.gov.au/def/voc/ga/SeabedGeomorphologySettings/slide",
