      {
        "@value": "slide (BGU)",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "A slide consists of the movement of a coherent mass of material along a distinct shear surface (modified from Goudie, 2006).",
        "@language": "en"
      }
    ]
  },
  {
    "@id": "https://pid.geoscience.gov.au/def/voc/ga/SeabedGeomorphologySettings/talus_apron",
