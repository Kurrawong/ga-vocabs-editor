      }
    ],
    "https://prez.dev/label": [
      {
        "@value": "topple (BGU)",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "A mass movement produced by forward rotation around a pivot or hinge on a slope below the centre of gravity of the displaced mass. Different types of FALLS are described by the nature of the material remobilized.",
        "@language": "en"
      }
    ]
  },
