      }
    ],
    "https://prez.dev/label": [
      {
        "@value": "mudflow fan (BGU)",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "A Fan formed by the accumulation of sediments as the result of multiple MUD FLOW events. These will be smaller and less complex than SUBMARINE FAN.",
        "@language": "en"
      }
    ]
  },
  {
    "@id": "https://pid.geoscience.gov.au/def/voc/ga/SeabedGeomorphologySettings/mudflow_gully",
