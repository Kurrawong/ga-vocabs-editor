  {
    "@id": "https://pid.geoscience.gov.au/def/voc/ga/SeabedGeomorphologySettings/complex",
    "https://prez.dev/identifier": [
      {
        "@value": "ns1:complex"
      }
    ],
    "https://prez.dev/link": [
      {
        "@value": "/catalogs/catalogue:default/collections/ns1:SeabedGeomorphologySettings/items/ns1:complex"
      }
    ],
    "https://prez.dev/label": [
      {
        "@value": "complex (BGU)",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "A mass movement where one form of failure develops into a second form of movement i.e. a change of behaviour downslope by the same material.",
        "@language": "en"
      }
    ]
  },
  {
    "@id": "https://pid.geoscience.gov.au/def/voc/ga/SeabedGeomorphologySettings/crown_crack",
    "https://prez.dev/identifier": [
      {
        "@value": "ns1:crown_crack"
      }
    ],
    "https://prez.dev/link": [
      {
        "@value": "/catalogs/catalogue:default/collections/ns1:SeabedGeomorphologySettings/items/ns1:crown_crack"
      }
    ],
    "https://prez.dev/label": [
      {
        "@value": "crown crack (BGU)",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "A type of open fracture found within partically undisplaced material upslope the EVACUATION AREA and generally parallel to the HEAD SCARP.",
        "@language": "en"
      }
    ]
  },
  {
    "@id": "https://pid.geoscience.gov.au/def/voc/ga/SeabedGeomorphologySettings/debris_apron",
    "https://prez.dev/identifier": [
      {
        "@value": "ns1:debris_apron"
      }
    ],
    "https://prez.dev/link": [
      {
        "@value": "/catalogs/catalogue:default/collections/ns1:SeabedGeomorphologySettings/items/ns1:debris_apron"
      }
    ],
    "https://prez.dev/label": [
      {
        "@value": "debris apron (BGU)",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "An Apron formed by the accumulation of debris at the base of a steep slope as the result of multiple mass movement events. These are not typically developed within the marine environment but can be found associated with nearshore slope instability.",
        "@language": "en"
      }
    ]
  },
  {
    "@id": "https://pid.geoscience.gov.au/def/voc/ga/SeabedGeomorphologySettings/debris_fan",
    "https://prez.dev/identifier": [
      {
        "@value": "ns1:debris_fan"
      }
    ],
    "https://prez.dev/link": [
      {
        "@value": "/catalogs/catalogue:default/collections/ns1:SeabedGeomorphologySettings/items/ns1:debris_fan"
      }
    ],
    "https://prez.dev/label": [
      {
        "@value": "debris fan (BGU)",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "A Fan formed by the accumulation of debris at the base of a steep slope, as the result of multiple mass movement events, in particular, DEBRIS FLOWS.",
        "@language": "en"
      }
    ]
  },
  {
    "@id": "https://pid.geoscience.gov.au/def/voc/ga/SeabedGeomorphologySettings/depositional_zone",
    "https://prez.dev/identifier": [
      {
        "@value": "ns1:depositional_zone"
      }
    ],
    "https://prez.dev/link": [
      {
        "@value": "/catalogs/catalogue:default/collections/ns1:SeabedGeomorphologySettings/items/ns1:depositional_zone"
      }
    ],
    "https://prez.dev/label": [
      {
        "@value": "depositional zone (BGU)",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "The most downslope zone of a mass movement, within which the displaced material lies above the original ground surface (modified from: Cruden, 1993). Its lower limit is set by the geometry of the TOE. The DEPOSITIONAL ZONE of SLIDES tends to be dominated by a compressional regime (e.g. thrust and fold systems), whereas for FLOWS the material tends to disperse forming fans or aprons at the base of the slope.",
        "@language": "en"
      }
    ]
  },
  {
    "@id": "https://pid.geoscience.gov.au/def/voc/ga/SeabedGeomorphologySettings/evacuation_zone",
    "https://prez.dev/identifier": [
      {
        "@value": "ns1:evacuation_zone"
      }
    ],
    "https://prez.dev/link": [
      {
        "@value": "/catalogs/catalogue:default/collections/ns1:SeabedGeomorphologySettings/items/ns1:evacuation_zone"
      }
    ],
    "https://prez.dev/label": [
      {
        "@value": "evacuation zone (BGU)",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "The most upslope zone of a mass movement, within which the remobilized material lies below the original ground surface (modified from: Cruden, 1993). Its upper limit is set by the geometry of the HEAD SCARP and this zone is normally dominated by extension features such as Blocks or elongated Ridges (Nissen et al., 1999).",
        "@language": "en"
      }
    ]
  },
  {
    "@id": "https://pid.geoscience.gov.au/def/voc/ga/SeabedGeomorphologySettings/extensional_ridge",
    "https://prez.dev/identifier": [
      {
        "@value": "ns1:extensional_ridge"
      }
    ],
    "https://prez.dev/link": [
      {
        "@value": "/catalogs/catalogue:default/collections/ns1:SeabedGeomorphologySettings/items/ns1:extensional_ridge"
      }
    ],
    "https://prez.dev/label": [
      {
        "@value": "extensional ridge (BGU)",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "An elongated Ridge separated by normal faults, typically observed close to the head scarp.",
        "@language": "en"
      }
    ]
  },
  {
    "@id": "https://pid.geoscience.gov.au/def/voc/ga/SeabedGeomorphologySettings/fall",
    "https://prez.dev/identifier": [
      {
        "@value": "ns1:fall"
      }
    ],
    "https://prez.dev/link": [
      {
        "@value": "/catalogs/catalogue:default/collections/ns1:SeabedGeomorphologySettings/items/ns1:fall"
      }
    ],
    "https://prez.dev/label": [
      {
        "@value": "fall (BGU)",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "A relatively free-falling abrupt movement of newly detached material from steep slopes or CLIFFS. The source area of a fall is not usually directly identified in bathymetry data, being only indirectly mapped, by identifying the cliff face associated with debris or rock fragments accumulation at the base of the slope. Different types of FALLS can be described by the nature of the material remobilized.",
        "@language": "en"
      }
    ]
  },
  {
    "@id": "https://pid.geoscience.gov.au/def/voc/ga/SeabedGeomorphologySettings/flow",
    "https://prez.dev/identifier": [
      {
        "@value": "ns1:flow"
      }
    ],
    "https://prez.dev/link": [
      {
        "@value": "/catalogs/catalogue:default/collections/ns1:SeabedGeomorphologySettings/items/ns1:flow"
      }
    ],
    "https://prez.dev/label": [
      {
        "@value": "flow (BGU)",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "A mass movement where the individual particles travel separately within a moving mass. They involve highly fractured rock, clastic debris in a fine matrix or small grain sizes.",
        "@language": "en"
      }
    ]
  },
  {
    "@id": "https://pid.geoscience.gov.au/def/voc/ga/SeabedGeomorphologySettings/head_scarp",
    "https://prez.dev/identifier": [
      {
        "@value": "ns1:head_scarp"
      }
    ],
    "https://prez.dev/link": [
      {
        "@value": "/catalogs/catalogue:default/collections/ns1:SeabedGeomorphologySettings/items/ns1:head_scarp"
      }
    ],
    "https://prez.dev/label": [
      {
        "@value": "head scarp (BGU)",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "The upslope boundary of a mass movement, set between undisturbed and remobilised material. It is the visible part of the surface of rupture and can be defined as an extensional failure surface linked at depth to the basal shear surface. In plan-view, head scarps are typified by an arcuate geometry well-defined continuous scarp, particularly in mass movements associated with a higher degree of desegregation (e.g., SLIDES, FLOWS). However, a head scarp can also present a sinuous geometry due to localised retrogressive erosion of the scarp (Bull et al., 2009).",
        "@language": "en"
      }
    ]
  },
  {
    "@id": "https://pid.geoscience.gov.au/def/voc/ga/SeabedGeomorphologySettings/lateral_scarp",
    "https://prez.dev/identifier": [
      {
        "@value": "ns1:lateral_scarp"
      }
    ],
    "https://prez.dev/link": [
      {
        "@value": "/catalogs/catalogue:default/collections/ns1:SeabedGeomorphologySettings/items/ns1:lateral_scarp"
      }
    ],
    "https://prez.dev/label": [
      {
        "@value": "lateral scarp (BGU)",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "A scarp, normally parallel to the main direction of transport, which represents the lateral confining boundary to a mass movement. Depending on the overall structure and type of collapse, a lateral scarp may only have a minor superficial expression or be associated with a steep relief.",
        "@language": "en"
      }
    ]
  },
  {
    "@id": "https://pid.geoscience.gov.au/def/voc/ga/SeabedGeomorphologySettings/lateral_spread",
    "https://prez.dev/identifier": [
      {
        "@value": "ns1:lateral_spread"
      }
    ],
    "https://prez.dev/link": [
      {
        "@value": "/catalogs/catalogue:default/collections/ns1:SeabedGeomorphologySettings/items/ns1:lateral_spread"
      }
    ],
    "https://prez.dev/label": [
      {
        "@value": "lateral spread (BGU)",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "A mass movement produced by the lateral extension of a cohesive rock or debris over a deforming mass of softer underlying material (modified from Goudie, 2006). They usually occur on very gentle slopes or flat terrain and the failure is caused by liquefaction, the process whereby saturated, loose, cohesionless sediments (usually sands and silts) are transformed from a solid into a liquefied state.",
        "@language": "en"
      }
    ]
  },
  {
    "@id": "https://pid.geoscience.gov.au/def/voc/ga/SeabedGeomorphologySettings/mass-movement_compressional_ridge",
    "https://prez.dev/identifier": [
      {
        "@value": "ns1:mass-movement_compressional_ridge"
      }
    ],
    "https://prez.dev/link": [
      {
        "@value": "/catalogs/catalogue:default/collections/ns1:SeabedGeomorphologySettings/items/ns1:mass-movement_compressional_ridge"
      }
    ],
    "https://prez.dev/label": [
      {
        "@value": "mass-movement compressional ridge (BGU)",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "An elongated ridge perpendicular to the main direction of transport, typically found in the distal parts of slides with the deformation front limiting the downslope extent of the slide.",
        "@language": "en"
      }
    ]
  },
  {
    "@id": "https://pid.geoscience.gov.au/def/voc/ga/SeabedGeomorphologySettings/mass-movement_toe",
    "https://prez.dev/identifier": [
      {
        "@value": "ns1:mass-movement_toe"
      }
    ],
    "https://prez.dev/link": [
      {
        "@value": "/catalogs/catalogue:default/collections/ns1:SeabedGeomorphologySettings/items/ns1:mass-movement_toe"
      }
    ],
    "https://prez.dev/label": [
      {
        "@value": "mass-movement toe (BGU)",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "The lower boundary of a mass movement, set between the remobilised and undisturbed material. In FRONTALLY CONFINED SLIDES this usually curved margin coincides with the intersection between the lower part of the surface of rupture of a landslide and the original ground surface. Where remobilised material is moved beyond the lower part of the surface of rupture the boundary may be diffuse and have limited bathymetric expression.",
        "@language": "en"
      }
    ]
  },
  {
    "@id": "https://pid.geoscience.gov.au/def/voc/ga/SeabedGeomorphologySettings/minor_scarp",
    "https://prez.dev/identifier": [
      {
        "@value": "ns1:minor_scarp"
      }
    ],
    "https://prez.dev/link": [
      {
        "@value": "/catalogs/catalogue:default/collections/ns1:SeabedGeomorphologySettings/items/ns1:minor_scarp"
      }
    ],
    "https://prez.dev/label": [
      {
        "@value": "minor scarp (BGU)",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "A scarp that can appear morphologically similar to a HEAD SCARP but is fully located within the EVACUATION ZONE and downslope of the HEAD SCARP.",
        "@language": "en"
      }
    ]
  },
  {
    "@id": "https://pid.geoscience.gov.au/def/voc/ga/SeabedGeomorphologySettings/mudflow_fan",
