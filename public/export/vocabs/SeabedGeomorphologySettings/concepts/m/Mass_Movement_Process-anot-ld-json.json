      }
    ],
    "https://prez.dev/label": [
      {
        "@value": "talus fan (BGU)",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "A Fan formed by the accumulation of broken rock fragments at the base of a steep slope as the result of multiple mass movement events. These are not typically developed within the marine environment but can be found associated to nearshore slope instability.",
        "@language": "en"
      }
    ]
  },
  {
