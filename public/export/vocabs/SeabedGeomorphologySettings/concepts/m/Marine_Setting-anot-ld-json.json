      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "A SETTING in which geomorphic UNITS are primarily formed below lowest astronomical tide by marine processes (waves, tides, oceanic and density currents, cumulative MASS MOVEMENT PROCESSES – e.g. SUBMARINE CANYONS).",
        "@language": "en"
      }
    ],
