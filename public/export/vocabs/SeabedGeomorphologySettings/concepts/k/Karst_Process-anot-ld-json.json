      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "Landscape where the dominant geomorphic processes are a combination of chemical weathering and other erosional processes of sandstone (quartz); characterised by distinctive rough terrain and landforms, e.g. ruiniform.",
