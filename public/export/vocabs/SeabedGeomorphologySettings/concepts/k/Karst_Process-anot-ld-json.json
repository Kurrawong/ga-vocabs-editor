    ],
    "https://prez.dev/label": [
      {
        "@value": "salt karst (BGU)",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "Landscape where the dominant geomorphic process is dissolution of salt (halite); characterised by distinctive rough terrain and landforms, e.g. dolines (modified after Field, 2002).",
        "@language": "en"
      }
    ]
  },
  {
