  {
    "@id": "https://pid.geoscience.gov.au/def/voc/ga/SeabedGeomorphologySettings",
    "https://prez.dev/identifier": [
      {
        "@value": "ns1:SeabedGeomorphologySettings"
      }
    ],
    "https://prez.dev/link": [
      {
        "@value": "/catalogs/catalogue:default/collections/ns1:SeabedGeomorphologySettings"
      }
    ],
    "https://prez.dev/label": [
      {
        "@value": "Seabed geomorphology - Part 2 Geomorphology",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "A vocabulary of GEOMORPHIC UNIT terms (Part 2) used in the two-part marine and coastal geomorphology classification scheme (International Seabed Geomorphology Mapping Working Group - ISGM-WG: Part 1 Morphology: [https://doi.org/10.5281/zenodo.4071940](https://doi.org/10.5281/zenodo.4071940); Part 2 Geomorphology: [https://doi.org/10.5281/zenodo.7804019](https://doi.org/10.5281/zenodo.7804019) to classify MORPHOLOGY FEATURES (Part 1) with their process interpretation. These UNIT terms are structured within a consistent framework design that is replicated between eleven SETTING and PROCESS categories.\n\nThis is one of four linked ISGM-WG vocabularies. Definitions in this vocabulary are subject to intermittent review and versioning. Unless otherwise stated, all definitions are derived from the Part 2 Geomorphology report (Version 1.0) [https://doi.org/10.5281/zenodo.7804019](https://doi.org/10.5281/zenodo.7804019)).",
        "@language": "en"
      }
    ],
    "https://prez.dev/members": [
      {
        "@value": "/catalogs/catalogue:default/collections/ns1:SeabedGeomorphologySettings/items"
      }
    ]
  },
  {
    "@id": "https://pid.geoscience.gov.au/def/voc/ga/SeabedGeomorphologySettings/seamount",
    "https://prez.dev/identifier": [
      {
        "@value": "ns1:seamount"
      }
    ],
    "https://prez.dev/link": [
      {
        "@value": "/catalogs/catalogue:default/collections/ns1:SeabedGeomorphologySettings/items/ns1:seamount"
      }
    ],
    "https://prez.dev/label": [
      {
        "@value": "seamount (BGU-T)",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "Any geographically isolated topographic unit on the seafloor taller than 1000 m. Most seamounts are formed by igneous activity close to mid-ocean ridges, island arcs, or in mid-plate settings, although blocks of continental crust, stranded during the opening of ocean basins, can form nonvolcanic seamounts (Harff et al., 2016; Harris and Baker, 2020).\nCf. \"seamount\" in Harris et al., (2014).",
        "@language": "en"
      }
    ]
  },
  {
    "@id": "https://pid.geoscience.gov.au/def/voc/ga/SeabedGeomorphologySettings/shield_volcano",
    "https://prez.dev/identifier": [
      {
        "@value": "ns1:shield_volcano"
      }
    ],
    "https://prez.dev/link": [
      {
        "@value": "/catalogs/catalogue:default/collections/ns1:SeabedGeomorphologySettings/items/ns1:shield_volcano"
      }
    ],
    "https://prez.dev/label": [
      {
        "@value": "shield volcano (BGU-T)",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "Very large, broad, shield-like VOLCANOES that have a low aspect ratio caused by low viscosity lava eruptions that spread far from the source (modified after Huggett, 2017).",
        "@language": "en"
      }
    ]
  },
  {
    "@id": "https://pid.geoscience.gov.au/def/voc/ga/SeabedGeomorphologySettings/stratovolcano",
    "https://prez.dev/identifier": [
      {
        "@value": "ns1:stratovolcano"
      }
    ],
    "https://prez.dev/link": [
      {
        "@value": "/catalogs/catalogue:default/collections/ns1:SeabedGeomorphologySettings/items/ns1:stratovolcano"
      }
    ],
    "https://prez.dev/label": [
      {
        "@value": "stratovolcano (BGU-T)",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "A conical VOLCANO built up by many layers of hardened lava and tephra (modified after Huggett, 2017).",
        "@language": "en"
      }
    ]
  },
