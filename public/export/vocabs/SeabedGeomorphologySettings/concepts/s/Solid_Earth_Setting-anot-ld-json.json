      }
    ],
    "https://prez.dev/label": [
      {
        "@value": "impact crater (BGU)",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "Remains of an ancient meteorite-impact structure on the Earth's surface, generally in the form of a circular scar of crushed and deformed bedrock (modified after Huggett, 2017).",
        "@language": "en"
      }
    ]
  },
