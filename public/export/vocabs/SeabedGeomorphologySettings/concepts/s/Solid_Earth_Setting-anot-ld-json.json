      }
    ],
    "https://prez.dev/label": [
      {
        "@value": "axial volcanic ridge (BGU)",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "Composite volcanic edifices, comprising an elongate, typically spreading normal orientated topographic high, produced within the inner valleys of mid-ocean ridges, usually those that are slow spreading  (modified after Harff et al., 2016).",
        "@language": "en"
      }
    ]
  },
