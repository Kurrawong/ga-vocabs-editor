      }
    ],
    "https://prez.dev/label": [
      {
        "@value": "guyot (BGU-T)",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "Flat-topped SEAMOUNTS or PLEATEAUS, usually former VOLCANOES, are formed by gradual subsidence through different stages. In many cases, they are capped by drowned atoll REEFS and pelagic sediment (modified after Harff et al., 2016).",
        "@language": "en"
      }
    ]
  },
  {
