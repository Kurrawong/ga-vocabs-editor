      }
    ],
    "https://prez.dev/label": [
      {
        "@value": "abyssal hill (BGU)",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "An isolated (or tract of) small elevation(s) on the deep seafloor parallel to a mid ocean ridge and formed by volcanism and block faulting.\nCf. \"abyss - hills\" in Harris et al., (2014).",
        "@language": "en"
      }
    ]
  },
  {
