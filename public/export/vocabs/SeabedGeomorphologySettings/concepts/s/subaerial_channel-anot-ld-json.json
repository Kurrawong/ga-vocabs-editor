      {
        "@value": "tidal inlet (BGU-T)",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "An opening in the shoreline through which water penetrates the land, thereby providing a connection between the open ocean and the BACK-BARRIER that is maintained by tidal currents (modified from Davis Jr and FitzGerald, 2009).",
