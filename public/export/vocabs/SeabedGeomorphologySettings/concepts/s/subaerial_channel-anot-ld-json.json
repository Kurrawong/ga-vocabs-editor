  {
    "@id": "https://pid.geoscience.gov.au/def/voc/ga/SeabedGeomorphologySettings",
    "https://prez.dev/identifier": [
      {
        "@value": "ns1:SeabedGeomorphologySettings"
      }
    ],
    "https://prez.dev/link": [
      {
        "@value": "/catalogs/catalogue:default/collections/ns1:SeabedGeomorphologySettings"
      }
    ],
    "https://prez.dev/label": [
      {
        "@value": "Seabed geomorphology - Part 2 Geomorphology",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "A vocabulary of GEOMORPHIC UNIT terms (Part 2) used in the two-part marine and coastal geomorphology classification scheme (International Seabed Geomorphology Mapping Working Group - ISGM-WG: Part 1 Morphology: [https://doi.org/10.5281/zenodo.4071940](https://doi.org/10.5281/zenodo.4071940); Part 2 Geomorphology: [https://doi.org/10.5281/zenodo.7804019](https://doi.org/10.5281/zenodo.7804019) to classify MORPHOLOGY FEATURES (Part 1) with their process interpretation. These UNIT terms are structured within a consistent framework design that is replicated between eleven SETTING and PROCESS categories.\n\nThis is one of four linked ISGM-WG vocabularies. Definitions in this vocabulary are subject to intermittent review and versioning. Unless otherwise stated, all definitions are derived from the Part 2 Geomorphology report (Version 1.0) [https://doi.org/10.5281/zenodo.7804019](https://doi.org/10.5281/zenodo.7804019)).",
        "@language": "en"
      }
    ],
    "https://prez.dev/members": [
      {
        "@value": "/catalogs/catalogue:default/collections/ns1:SeabedGeomorphologySettings/items"
      }
    ]
  },
  {
    "@id": "https://pid.geoscience.gov.au/def/voc/ga/SeabedGeomorphologySettings/creek",
    "https://prez.dev/identifier": [
      {
        "@value": "ns1:creek"
      }
    ],
    "https://prez.dev/link": [
      {
        "@value": "/catalogs/catalogue:default/collections/ns1:SeabedGeomorphologySettings/items/ns1:creek"
      }
    ],
    "https://prez.dev/label": [
      {
        "@value": "creek (BGU-T)",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "A relatively minor SUBAERIAL CHANNEL, which may be a tributary to a RIVER or DISTRIBUTARY or may flow directly into a BACKBARRIER or the open coast.",
        "@language": "en"
      }
    ]
  },
  {
    "@id": "https://pid.geoscience.gov.au/def/voc/ga/SeabedGeomorphologySettings/distributary",
    "https://prez.dev/identifier": [
      {
        "@value": "ns1:distributary"
      }
    ],
    "https://prez.dev/link": [
      {
        "@value": "/catalogs/catalogue:default/collections/ns1:SeabedGeomorphologySettings/items/ns1:distributary"
      }
    ],
    "https://prez.dev/label": [
      {
        "@value": "distributary (BGU-T)",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "DISTRIBUTARY channels radiate from a parent SUBAERIAL CHANNEL, which they may re-join, and tend to decrease in capacity and sediment calibre, and increase in heterogeneity, downstream as they become increasingly influenced by coastal processes (e.g. tides, waves, backwater effects: Nichols and Fisher, 2007; cf. Lane et al., 2017).",
        "@language": "en"
      }
    ]
  },
  {
    "@id": "https://pid.geoscience.gov.au/def/voc/ga/SeabedGeomorphologySettings/gully",
    "https://prez.dev/identifier": [
      {
        "@value": "ns1:gully"
      }
    ],
    "https://prez.dev/link": [
      {
        "@value": "/catalogs/catalogue:default/collections/ns1:SeabedGeomorphologySettings/items/ns1:gully"
      }
    ],
    "https://prez.dev/label": [
      {
        "@value": "gully (BGU-T)",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "Though diverse in form, GULLIES tend to be relatively small (though larger than RILLS), steep, narrow, deeply incised SUBAERIAL CHANNELS that are carved into unconsolidated regolith (modified from Goudie, 2006).",
        "@language": "en"
      }
    ]
  },
  {
    "@id": "https://pid.geoscience.gov.au/def/voc/ga/SeabedGeomorphologySettings/rill",
    "https://prez.dev/identifier": [
      {
        "@value": "ns1:rill"
      }
    ],
    "https://prez.dev/link": [
      {
        "@value": "/catalogs/catalogue:default/collections/ns1:SeabedGeomorphologySettings/items/ns1:rill"
      }
    ],
    "https://prez.dev/label": [
      {
        "@value": "rill (BGU-T)",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "Very small (< 30 cm depth and width) SUBAERIAL CHANNELS caused by runoff from rainsplash puddles. RILLS sometimes extend downslope where they can flow into GULLIES (modified from Goudie, 2006).",
        "@language": "en"
      }
    ]
  },
  {
    "@id": "https://pid.geoscience.gov.au/def/voc/ga/SeabedGeomorphologySettings/river",
    "https://prez.dev/identifier": [
      {
        "@value": "ns1:river"
      }
    ],
    "https://prez.dev/link": [
      {
        "@value": "/catalogs/catalogue:default/collections/ns1:SeabedGeomorphologySettings/items/ns1:river"
      }
    ],
    "https://prez.dev/label": [
      {
        "@value": "river (BGU-T)",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "A relatively large SUBAERIAL CHANNEL.",
        "@language": "en"
      }
    ]
  },
