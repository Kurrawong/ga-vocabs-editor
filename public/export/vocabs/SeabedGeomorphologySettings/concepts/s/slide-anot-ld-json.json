  {
    "@id": "https://pid.geoscience.gov.au/def/voc/ga/SeabedGeomorphologySettings",
    "https://prez.dev/identifier": [
      {
        "@value": "ns1:SeabedGeomorphologySettings"
      }
    ],
    "https://prez.dev/link": [
      {
        "@value": "/catalogs/catalogue:default/collections/ns1:SeabedGeomorphologySettings"
      }
    ],
    "https://prez.dev/label": [
      {
        "@value": "Seabed geomorphology - Part 2 Geomorphology",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "A vocabulary of GEOMORPHIC UNIT terms (Part 2) used in the two-part marine and coastal geomorphology classification scheme (International Seabed Geomorphology Mapping Working Group - ISGM-WG: Part 1 Morphology: [https://doi.org/10.5281/zenodo.4071940](https://doi.org/10.5281/zenodo.4071940); Part 2 Geomorphology: [https://doi.org/10.5281/zenodo.7804019](https://doi.org/10.5281/zenodo.7804019) to classify MORPHOLOGY FEATURES (Part 1) with their process interpretation. These UNIT terms are structured within a consistent framework design that is replicated between eleven SETTING and PROCESS categories.\n\nThis is one of four linked ISGM-WG vocabularies. Definitions in this vocabulary are subject to intermittent review and versioning. Unless otherwise stated, all definitions are derived from the Part 2 Geomorphology report (Version 1.0) [https://doi.org/10.5281/zenodo.7804019](https://doi.org/10.5281/zenodo.7804019)).",
        "@language": "en"
      }
    ],
    "https://prez.dev/members": [
      {
        "@value": "/catalogs/catalogue:default/collections/ns1:SeabedGeomorphologySettings/items"
      }
    ]
  },
  {
    "@id": "https://pid.geoscience.gov.au/def/voc/ga/SeabedGeomorphologySettings/frontally_confined_slide",
    "https://prez.dev/identifier": [
      {
        "@value": "ns1:frontally_confined_slide"
      }
    ],
    "https://prez.dev/link": [
      {
        "@value": "/catalogs/catalogue:default/collections/ns1:SeabedGeomorphologySettings/items/ns1:frontally_confined_slide"
      }
    ],
    "https://prez.dev/label": [
      {
        "@value": "frontally confined slide (BGU-T)",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "A SLIDE where the compressional TOE region was buttressed by a ramp separating their fill from their foreland. This type of SLIDE does not show a prominent bathymetric expression compared to their total thickening and implies a relatively modest downslope transfer of sediment (Frey-Martínez et al., 2006).",
        "@language": "en"
      }
    ]
  },
  {
    "@id": "https://pid.geoscience.gov.au/def/voc/ga/SeabedGeomorphologySettings/frontally_emergent_slide",
    "https://prez.dev/identifier": [
      {
        "@value": "ns1:frontally_emergent_slide"
      }
    ],
    "https://prez.dev/link": [
      {
        "@value": "/catalogs/catalogue:default/collections/ns1:SeabedGeomorphologySettings/items/ns1:frontally_emergent_slide"
      }
    ],
    "https://prez.dev/label": [
      {
        "@value": "frontally emergent slide (BGU-T)",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "A SLIDE where the compressional TOE region develops above the downslope undisturbed strata, having overridden their ramps. This type of SLIDE shows major bathymetric expressions and involves the downslope transport of significant volumes of material (Frey-Martínez et al., 2006).",
        "@language": "en"
      }
    ]
  },
  {
    "@id": "https://pid.geoscience.gov.au/def/voc/ga/SeabedGeomorphologySettings/rotational_slide",
    "https://prez.dev/identifier": [
      {
        "@value": "ns1:rotational_slide"
      }
    ],
    "https://prez.dev/link": [
      {
        "@value": "/catalogs/catalogue:default/collections/ns1:SeabedGeomorphologySettings/items/ns1:rotational_slide"
      }
    ],
    "https://prez.dev/label": [
      {
        "@value": "rotational slide (BGU-T)",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "A type of SLIDE characterised by a rotational movement on a circular or spoon-shaped shear surface.",
        "@language": "en"
      }
    ]
  },
