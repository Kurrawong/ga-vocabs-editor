{"@context":{"iri":"@id","prefLabel":"http://www.w3.org/2004/02/skos/core#prefLabel","altLabels":"http://www.w3.org/2004/02/skos/core#altLabel","definition":"http://www.w3.org/2004/02/skos/core#definition","notation":"http://www.w3.org/2004/02/skos/core#notation","broader":"http://www.w3.org/2004/02/skos/core#broader","scheme":"http://www.w3.org/2004/02/skos/core#inScheme","schemeLabel":"https://prez.dev/schemeLabel"},"@graph":[{"iri":"https://pid.geoscience.gov.au/def/voc/ga/materialtype/adsorbed_phase","prefLabel":"adsorbed phase","definition":"An ion attached to the surface of a mineral","scheme":"https://pid.geoscience.gov.au/def/voc/ga/materialtype","schemeLabel":"General Geology - Sample Material Class"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/materialtype/air","prefLabel":"air","definition":"The composite gas comprising the Earth's atmosphere.","broader":"https://pid.geoscience.gov.au/def/voc/ga/materialtype/inorganic_gas","scheme":"https://pid.geoscience.gov.au/def/voc/ga/materialtype","schemeLabel":"General Geology - Sample Material Class"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/materialtype/animal_material","prefLabel":"animal material","altLabels":["organism"],"definition":"Any material of or excreted from an animal.  e.g., animal tissue, faeces, hair","broader":"https://pid.geoscience.gov.au/def/voc/ga/materialtype/organic_material","scheme":"https://pid.geoscience.gov.au/def/voc/ga/materialtype","schemeLabel":"General Geology - Sample Material Class"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/materialtype/animalTissue","prefLabel":"animal tissue","definition":"Material of an animal's body","broader":"https://pid.geoscience.gov.au/def/voc/ga/materialtype/animal_material","scheme":"https://pid.geoscience.gov.au/def/voc/ga/materialtype","schemeLabel":"General Geology - Sample Material Class"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/materialtype/atmospheric_dust","prefLabel":"atmospheric dust","definition":"Fine-grained solid material collected or filtered from the atmosphere","scheme":"https://pid.geoscience.gov.au/def/voc/ga/materialtype","schemeLabel":"General Geology - Sample Material Class"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/materialtype/bark","prefLabel":"bark","definition":"Outermost layers of stems and roots of woody plants","broader":"https://pid.geoscience.gov.au/def/voc/ga/materialtype/vegetation","scheme":"https://pid.geoscience.gov.au/def/voc/ga/materialtype","schemeLabel":"General Geology - Sample Material Class"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/materialtype/bitumen","prefLabel":"bitumen","definition":"Solid organic material that forms part of a rock. It can usually be extracted from the rock with organic solvent.","broader":"https://pid.geoscience.gov.au/def/voc/ga/materialtype/hydrocarbon_material","scheme":"https://pid.geoscience.gov.au/def/voc/ga/materialtype","schemeLabel":"General Geology - Sample Material Class"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/materialtype/catchment_outlet_sediment","prefLabel":"catchment outlet sediment","definition":"Terrestrial sediment deposited on a low-lying or flat landscape adjacent to a stream but outside its banks and close to the lower boundary of a hydrologic catchment; may have an aeolian component mixed in with fluvial sediments.","broader":"https://pid.geoscience.gov.au/def/voc/ga/materialtype/sediment","scheme":"https://pid.geoscience.gov.au/def/voc/ga/materialtype","schemeLabel":"General Geology - Sample Material Class"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/materialtype/coal","prefLabel":"coal","definition":"A readily combustible organic rock containing more than 50 percent by weight and more than 70 percent by volume of carbonaceous material.","broader":"https://pid.geoscience.gov.au/def/voc/ga/materialtype/organic_material","scheme":"https://pid.geoscience.gov.au/def/voc/ga/materialtype","schemeLabel":"General Geology - Sample Material Class"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/materialtype/coke","prefLabel":"coke","definition":"A solid of carbonaceous material derived from the destructive distillation of low-ash, low-sulphur bituminous coal.","broader":"https://pid.geoscience.gov.au/def/voc/ga/materialtype/organic_material","scheme":"https://pid.geoscience.gov.au/def/voc/ga/materialtype","schemeLabel":"General Geology - Sample Material Class"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/materialtype/condensate","prefLabel":"condensate","definition":"A material that exists as gas in the subsurface but condenses into liquid at the surface.","broader":"https://pid.geoscience.gov.au/def/voc/ga/materialtype/fluid_hydrocarbon","scheme":"https://pid.geoscience.gov.au/def/voc/ga/materialtype","schemeLabel":"General Geology - Sample Material Class"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/materialtype/coral","prefLabel":"coral","definition":"Hard stony substance secreted by certain marine coelenterates as an external skeleton, typically forming large reefs in warm seas","broader":"https://pid.geoscience.gov.au/def/voc/ga/materialtype/rock","scheme":"https://pid.geoscience.gov.au/def/voc/ga/materialtype","schemeLabel":"General Geology - Sample Material Class"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/materialtype/crude_oil","prefLabel":"crude oil","definition":"A naturally occurring complex liquid hydrocarbon, typically found as part of drilling activity, which after distillation and removal of impurities yields a range of combustible fuels, petrochemicals and lubricants.","broader":"https://pid.geoscience.gov.au/def/voc/ga/materialtype/fluid_hydrocarbon","scheme":"https://pid.geoscience.gov.au/def/voc/ga/materialtype","schemeLabel":"General Geology - Sample Material Class"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/materialtype/crude_oil_with_water","prefLabel":"crude oil with water","definition":"A mixture of oil and water where oil is the main phase.","broader":"https://pid.geoscience.gov.au/def/voc/ga/materialtype/fluid_hydrocarbon","scheme":"https://pid.geoscience.gov.au/def/voc/ga/materialtype","schemeLabel":"General Geology - Sample Material Class"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/materialtype/distilled_water","prefLabel":"distilled water","definition":"Water from which impurities, as dissolved salts and colloidal particles, have been removed by one or more processes of distillation; chemically pure water.","broader":"https://pid.geoscience.gov.au/def/voc/ga/materialtype/water","scheme":"https://pid.geoscience.gov.au/def/voc/ga/materialtype","schemeLabel":"General Geology - Sample Material Class"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/materialtype/drilling_fluid","prefLabel":"drilling fluid","definition":"Fluid used for drill bit lubrication and return of ground rock material from the drill bit, e.g. mud.","broader":"https://pid.geoscience.gov.au/def/voc/ga/materialtype/fluid","scheme":"https://pid.geoscience.gov.au/def/voc/ga/materialtype","schemeLabel":"General Geology - Sample Material Class"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/materialtype/estuarine_water","prefLabel":"estuarine water","definition":"Water from an estuary. Depending on the nature of the estuary, the salinity may vary spatially and temporally and range from fresh, brackish, sea_water or hypersaline.","broader":"https://pid.geoscience.gov.au/def/voc/ga/materialtype/water","scheme":"https://pid.geoscience.gov.au/def/voc/ga/materialtype","schemeLabel":"General Geology - Sample Material Class"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/materialtype/faeces","prefLabel":"faeces","definition":"Waste material excreted from an animal","broader":"https://pid.geoscience.gov.au/def/voc/ga/materialtype/animal_material","scheme":"https://pid.geoscience.gov.au/def/voc/ga/materialtype","schemeLabel":"General Geology - Sample Material Class"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/materialtype/fluid","prefLabel":"fluid","definition":"Unspecified fluid material.","scheme":"https://pid.geoscience.gov.au/def/voc/ga/materialtype","schemeLabel":"General Geology - Sample Material Class"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/materialtype/fluid_hydrocarbon","prefLabel":"fluid hydrocarbon","definition":"Any carbon-hydrogen fluid material","broader":"https://pid.geoscience.gov.au/def/voc/ga/materialtype/hydrocarbon_material","scheme":"https://pid.geoscience.gov.au/def/voc/ga/materialtype","schemeLabel":"General Geology - Sample Material Class"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/materialtype/foliage","prefLabel":"foliage","definition":"Plant leaves, especially tree leaves, considered as a group","broader":"https://pid.geoscience.gov.au/def/voc/ga/materialtype/vegetation","scheme":"https://pid.geoscience.gov.au/def/voc/ga/materialtype","schemeLabel":"General Geology - Sample Material Class"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/materialtype/gas_in_solution","prefLabel":"gas in solution","definition":"A gas that that is exsolved from a liquid, such as water or oil, at the surface or under experimental conditions.","broader":"https://pid.geoscience.gov.au/def/voc/ga/materialtype/hydrocarbon_gas","scheme":"https://pid.geoscience.gov.au/def/voc/ga/materialtype","schemeLabel":"General Geology - Sample Material Class"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/materialtype/groundwater","prefLabel":"groundwater","altLabels":["formation water"],"definition":"Synonym: formation water.  Part of the subsurface water that is in the zone of saturation, i.e., below the water table.  Can be located in one or several aquifers, aquicludes or aquitards.","broader":"https://pid.geoscience.gov.au/def/voc/ga/materialtype/water","scheme":"https://pid.geoscience.gov.au/def/voc/ga/materialtype","schemeLabel":"General Geology - Sample Material Class"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/materialtype/groundwater_with_oil","prefLabel":"groundwater with oil","definition":"A sample containing a mixture of water and oil and may be an immulsion. Water is the main phase and hydrocarbons - e.g. benzene, toluene - are dissolved within the water. Synonym: formation water with oil","scheme":"https://pid.geoscience.gov.au/def/voc/ga/materialtype","schemeLabel":"General Geology - Sample Material Class"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/materialtype/hair","prefLabel":"hair","definition":"Hair or fur from an animal","broader":"https://pid.geoscience.gov.au/def/voc/ga/materialtype/animal_material","scheme":"https://pid.geoscience.gov.au/def/voc/ga/materialtype","schemeLabel":"General Geology - Sample Material Class"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/materialtype/hydrocarbon_gas","prefLabel":"hydrocarbon gas","definition":"A fluid hydrocarbon that is a gas at the surface. In the subsurface this sample maybe be free of liquid hydrocarbons, contain dissolved liquid hydrocarbons, or be dissolved in oil. ","broader":"https://pid.geoscience.gov.au/def/voc/ga/materialtype/fluid_hydrocarbon","scheme":"https://pid.geoscience.gov.au/def/voc/ga/materialtype","schemeLabel":"General Geology - Sample Material Class"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/materialtype/hydrocarbon_material","prefLabel":"hydrocarbon material","definition":"Any carbon-hydrogen based material.","broader":"https://pid.geoscience.gov.au/def/voc/ga/materialtype/organic_material","scheme":"https://pid.geoscience.gov.au/def/voc/ga/materialtype","schemeLabel":"General Geology - Sample Material Class"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/materialtype/ice","prefLabel":"ice","definition":"Frozen, solid water.","scheme":"https://pid.geoscience.gov.au/def/voc/ga/materialtype","schemeLabel":"General Geology - Sample Material Class"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/materialtype/inorganic_gas","prefLabel":"inorganic gas","definition":"Any non-hydrocarbon-based gas.","scheme":"https://pid.geoscience.gov.au/def/voc/ga/materialtype","schemeLabel":"General Geology - Sample Material Class"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/materialtype/kerogen","prefLabel":"kerogen","definition":"Immobile organic matter that forms part of a rock. Kerogen cannot be extracted from the rock with organic solvents. Kerogen is concentrated in a pure form by removal of the mineral matter with strong acids - ie., HCl, HF.","broader":"https://pid.geoscience.gov.au/def/voc/ga/materialtype/hydrocarbon_material","scheme":"https://pid.geoscience.gov.au/def/voc/ga/materialtype","schemeLabel":"General Geology - Sample Material Class"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/materialtype/lag","prefLabel":"lag","definition":"Deposit, commonly thin, or fragments of larger than sand size, spread over the land surface.  Its most common origin is as the coarse material left behind after fine material has been transported away by wind, or less commonly, sheet flow.","broader":"https://pid.geoscience.gov.au/def/voc/ga/materialtype/regolith","scheme":"https://pid.geoscience.gov.au/def/voc/ga/materialtype","schemeLabel":"General Geology - Sample Material Class"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/materialtype/lake_sediment","prefLabel":"lake sediment","definition":"A sediment deposited in a body of standing fresh water","broader":"https://pid.geoscience.gov.au/def/voc/ga/materialtype/sediment","scheme":"https://pid.geoscience.gov.au/def/voc/ga/materialtype","schemeLabel":"General Geology - Sample Material Class"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/materialtype/manufactured_material","prefLabel":"manufactured material","definition":"Anthropogenic materials used for scientific analysis or observation, e.g., plastic, paint, metal, wood, fibre, glass etc","scheme":"https://pid.geoscience.gov.au/def/voc/ga/materialtype","schemeLabel":"General Geology - Sample Material Class"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/materialtype/marine_sediment","prefLabel":"marine sediment","definition":"A sediment, including pore_water, deposited in a submarine or coastal, brackish or saline environment.","scheme":"https://pid.geoscience.gov.au/def/voc/ga/materialtype","schemeLabel":"General Geology - Sample Material Class"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/materialtype/marine_sediment_overlying_sea_water","prefLabel":"marine sediment and overlying sea_water","definition":"A marine sediment core that is collected together with the overlying water, as in a core incubation experiment, or a known area of seafloor and overlying water column, as in a chamber incubation experiment.","broader":"https://pid.geoscience.gov.au/def/voc/ga/materialtype/marine_sediment","scheme":"https://pid.geoscience.gov.au/def/voc/ga/materialtype","schemeLabel":"General Geology - Sample Material Class"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/materialtype/meteorite","prefLabel":"meteorite","definition":"A rock that landed on Earth from an extraterrestrial source","broader":"https://pid.geoscience.gov.au/def/voc/ga/materialtype/rock","scheme":"https://pid.geoscience.gov.au/def/voc/ga/materialtype","schemeLabel":"General Geology - Sample Material Class"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/materialtype/mine_seep_water","prefLabel":"mine seep water","definition":"Water seeping from mine workings.","broader":"https://pid.geoscience.gov.au/def/voc/ga/materialtype/water","scheme":"https://pid.geoscience.gov.au/def/voc/ga/materialtype","schemeLabel":"General Geology - Sample Material Class"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/materialtype/mineral","prefLabel":"mineral","definition":"A naturally occurring inorganic, crystalline, element or compound","scheme":"https://pid.geoscience.gov.au/def/voc/ga/materialtype","schemeLabel":"General Geology - Sample Material Class"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/materialtype/mixed_rock_and_sediment","prefLabel":"mixed rock and sediment","definition":"A sample containing a mixture of rock and unconsolidated sediment.","broader":"https://pid.geoscience.gov.au/def/voc/ga/materialtype/regolith","scheme":"https://pid.geoscience.gov.au/def/voc/ga/materialtype","schemeLabel":"General Geology - Sample Material Class"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/materialtype/mud_gas","prefLabel":"mud gas","definition":"Small amounts of hydrocarbon gases in air that are collected from the circulating mud stream during drilling.","broader":"https://pid.geoscience.gov.au/def/voc/ga/materialtype/hydrocarbon_gas","scheme":"https://pid.geoscience.gov.au/def/voc/ga/materialtype","schemeLabel":"General Geology - Sample Material Class"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/materialtype/organic_material","prefLabel":"organic material","definition":"Any carbon-based material.","scheme":"https://pid.geoscience.gov.au/def/voc/ga/materialtype","schemeLabel":"General Geology - Sample Material Class"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/materialtype/overbank_sediment","prefLabel":"overbank sediment","definition":"Alluvium that is deposited outside an alluvial channel from flowing water which has overflowed from the channel.  It includes levees and back swamp deposits.","broader":"https://pid.geoscience.gov.au/def/voc/ga/materialtype/sediment","scheme":"https://pid.geoscience.gov.au/def/voc/ga/materialtype","schemeLabel":"General Geology - Sample Material Class"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/materialtype/pitch","prefLabel":"pitch","definition":"Any of the various dark heavy viscous and resinous substances obtained as a residue from the distillation of coal-tar or crude oil.","broader":"https://pid.geoscience.gov.au/def/voc/ga/materialtype/hydrocarbon_material","scheme":"https://pid.geoscience.gov.au/def/voc/ga/materialtype","schemeLabel":"General Geology - Sample Material Class"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/materialtype/plant_stem","prefLabel":"plant stem","definition":"Stem, trunk, branch and twig material from a plant","broader":"https://pid.geoscience.gov.au/def/voc/ga/materialtype/vegetation","scheme":"https://pid.geoscience.gov.au/def/voc/ga/materialtype","schemeLabel":"General Geology - Sample Material Class"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/materialtype/pore_water","prefLabel":"pore water","definition":"Subsurface water in an interstice between grains in a marine sediment.","broader":"https://pid.geoscience.gov.au/def/voc/ga/materialtype/water","scheme":"https://pid.geoscience.gov.au/def/voc/ga/materialtype","schemeLabel":"General Geology - Sample Material Class"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/materialtype/rain_water","prefLabel":"rain water","definition":"Rain water, collected before it hits the Earth's surface.","broader":"https://pid.geoscience.gov.au/def/voc/ga/materialtype/water","scheme":"https://pid.geoscience.gov.au/def/voc/ga/materialtype","schemeLabel":"General Geology - Sample Material Class"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/materialtype/refined_oil","prefLabel":"refined oil","definition":"Oil that has been processed in an oil refinery.","broader":"https://pid.geoscience.gov.au/def/voc/ga/materialtype/fluid_hydrocarbon","scheme":"https://pid.geoscience.gov.au/def/voc/ga/materialtype","schemeLabel":"General Geology - Sample Material Class"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/materialtype/regolith","prefLabel":"regolith","definition":"Typically unconsolidated or fragmental material, either transported or residual origin, which covers bedrock. Includes surficial duricrusts that cap bedrock.","scheme":"https://pid.geoscience.gov.au/def/voc/ga/materialtype","schemeLabel":"General Geology - Sample Material Class"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/materialtype/resin","prefLabel":"resin","definition":"Solid organic material that forms part of a rock. It is usually associated with coal and derived from the resinous material exuded from land plants.","broader":"https://pid.geoscience.gov.au/def/voc/ga/materialtype/hydrocarbon_material","scheme":"https://pid.geoscience.gov.au/def/voc/ga/materialtype","schemeLabel":"General Geology - Sample Material Class"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/materialtype/river_water","prefLabel":"river water","altLabels":["stream water"],"definition":"Water sampled from a river.","broader":"https://pid.geoscience.gov.au/def/voc/ga/materialtype/surface_water","scheme":"https://pid.geoscience.gov.au/def/voc/ga/materialtype","schemeLabel":"General Geology - Sample Material Class"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/materialtype/rock","prefLabel":"rock","definition":"A consolidated aggregate of one or more minerals or other rocks","scheme":"https://pid.geoscience.gov.au/def/voc/ga/materialtype","schemeLabel":"General Geology - Sample Material Class"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/materialtype/root","prefLabel":"root","definition":"The part of a plant that bears no leaves and typically, but not always, lies below the surface of the soil and is used for absorption of water and inorganic nutrients","broader":"https://pid.geoscience.gov.au/def/voc/ga/materialtype/vegetation","scheme":"https://pid.geoscience.gov.au/def/voc/ga/materialtype","schemeLabel":"General Geology - Sample Material Class"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/materialtype/sea_water","prefLabel":"sea water","altLabels":["ocean water","sea_water"],"definition":"Saline water from the Earth's seas and oceans","broader":"https://pid.geoscience.gov.au/def/voc/ga/materialtype/water","scheme":"https://pid.geoscience.gov.au/def/voc/ga/materialtype","schemeLabel":"General Geology - Sample Material Class"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/materialtype/sediment","prefLabel":"sediment","definition":"Unconsolidated sedimentary material.","broader":"https://pid.geoscience.gov.au/def/voc/ga/materialtype/regolith","scheme":"https://pid.geoscience.gov.au/def/voc/ga/materialtype","schemeLabel":"General Geology - Sample Material Class"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/materialtype/seep_gas","prefLabel":"seep gas","definition":"Gas that seeps at the Earths surface and recovered without the need for drilling.","broader":"https://pid.geoscience.gov.au/def/voc/ga/materialtype/hydrocarbon_gas","scheme":"https://pid.geoscience.gov.au/def/voc/ga/materialtype","schemeLabel":"General Geology - Sample Material Class"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/materialtype/seep_oil","prefLabel":"seep oil","definition":"Crude oil that seeps at the Earths surface and recovered without the need for drilling.","broader":"https://pid.geoscience.gov.au/def/voc/ga/materialtype/crude_oil","scheme":"https://pid.geoscience.gov.au/def/voc/ga/materialtype","schemeLabel":"General Geology - Sample Material Class"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/materialtype/seep_oil_and_gas","prefLabel":"seep oil and gas","definition":"Crude oil and gas that seeps at the Earths surface and recovered without the need for drilling.","broader":"https://pid.geoscience.gov.au/def/voc/ga/materialtype/fluid_hydrocarbon","scheme":"https://pid.geoscience.gov.au/def/voc/ga/materialtype","schemeLabel":"General Geology - Sample Material Class"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/materialtype/snow","prefLabel":"snow","definition":"Atmospheric water vapour frozen into ice crystals and falling in light white flakes or lying on the ground as a white layer.","scheme":"https://pid.geoscience.gov.au/def/voc/ga/materialtype","schemeLabel":"General Geology - Sample Material Class"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/materialtype/soil","prefLabel":"soil","definition":"Unconsolidated mineral or organic material on the Earth's surface that serves as a natural medium for the growth of land plants.","broader":"https://pid.geoscience.gov.au/def/voc/ga/materialtype/regolith","scheme":"https://pid.geoscience.gov.au/def/voc/ga/materialtype","schemeLabel":"General Geology - Sample Material Class"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/materialtype/solid_phase","prefLabel":"solid phase","definition":"The solid material left over after the pore water has been extracted from a sediment sample.","broader":"https://pid.geoscience.gov.au/def/voc/ga/materialtype/sediment","scheme":"https://pid.geoscience.gov.au/def/voc/ga/materialtype","schemeLabel":"General Geology - Sample Material Class"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/materialtype/spring_water","prefLabel":"spring water","definition":"Water sampled from a spring.","broader":"https://pid.geoscience.gov.au/def/voc/ga/materialtype/water","scheme":"https://pid.geoscience.gov.au/def/voc/ga/materialtype","schemeLabel":"General Geology - Sample Material Class"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/materialtype/stream_sediment","prefLabel":"stream sediment","definition":"A sediment deposited in the bed of an active or perennial stream","scheme":"https://pid.geoscience.gov.au/def/voc/ga/materialtype","schemeLabel":"General Geology - Sample Material Class"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/materialtype/surface_water","prefLabel":"surface water","definition":"Fresh or brackish water which occurs on the surface of a land mass.  e.g., rivers, creeks, lakes","broader":"https://pid.geoscience.gov.au/def/voc/ga/materialtype/water","scheme":"https://pid.geoscience.gov.au/def/voc/ga/materialtype","schemeLabel":"General Geology - Sample Material Class"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/materialtype/suspended_solids","prefLabel":"suspended solids","definition":"Sediment and biological particles collected from a water column that are separated by filtration and are not dissolved.","scheme":"https://pid.geoscience.gov.au/def/voc/ga/materialtype","schemeLabel":"General Geology - Sample Material Class"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/materialtype/unknown","prefLabel":"unknown","definition":"Material type is unknown","scheme":"https://pid.geoscience.gov.au/def/voc/ga/materialtype","schemeLabel":"General Geology - Sample Material Class"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/materialtype/unspecified_seabed_materials","prefLabel":"unspecified seabed materials","definition":"A sample that contains a mixture of materials from the seabed, possibly animal, vegetable, and mineral material.","scheme":"https://pid.geoscience.gov.au/def/voc/ga/materialtype","schemeLabel":"General Geology - Sample Material Class"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/materialtype/vegetation","prefLabel":"vegetation","altLabels":["plant material"],"definition":"Any part of a plant whether it be moss, grass, sedge, or the roots, bark, twigs or leaves of trees and shrubs.","broader":"https://pid.geoscience.gov.au/def/voc/ga/materialtype/organic_material","scheme":"https://pid.geoscience.gov.au/def/voc/ga/materialtype","schemeLabel":"General Geology - Sample Material Class"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/materialtype/water","prefLabel":"water","definition":"Undivided saline, brackish, or fresh water.","scheme":"https://pid.geoscience.gov.au/def/voc/ga/materialtype","schemeLabel":"General Geology - Sample Material Class"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/materialtype/wax","prefLabel":"wax","definition":"A light coloured solid precipitated from either a hydrocarbon gas or oil","broader":"https://pid.geoscience.gov.au/def/voc/ga/materialtype/hydrocarbon_material","scheme":"https://pid.geoscience.gov.au/def/voc/ga/materialtype","schemeLabel":"General Geology - Sample Material Class"}]}