  {
    "@id": "https://pid.geoscience.gov.au/def/voc/ga/ContactType/angular-unconformable-contact",
    "https://prez.dev/identifier": [
      {
        "@value": "ns1:angular-unconformable-contact"
      }
    ],
    "https://prez.dev/link": [
      {
        "@value": "/catalogs/catalogue:default/collections/ns1:ContactType/items/ns1:angular-unconformable-contact"
      }
    ],
    "https://prez.dev/label": [
      {
        "@value": "angular unconformable contact",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "An unconformable contact between two geological units in which the older, underlying rocks dip at an angle different from the younger, overlying strata, usually in which younger sediments rest upon the eroded surface of tilted or folded older rocks.",
        "@language": "en"
      }
    ]
  },
  {
    "@id": "https://pid.geoscience.gov.au/def/voc/ga/ContactType/disconformable-contact",
    "https://prez.dev/identifier": [
      {
        "@value": "ns1:disconformable-contact"
      }
    ],
    "https://prez.dev/link": [
      {
        "@value": "/catalogs/catalogue:default/collections/ns1:ContactType/items/ns1:disconformable-contact"
      }
    ],
    "https://prez.dev/label": [
      {
        "@value": "disconformable contact",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "An unconformable contact between two geological units in which the bedding of the older, underlying unit is parallel to the bedding of the younger, overlying unit, but in which the contact between the two units is marked by an irregular or uneven surface of appreciable relief.",
        "@language": "en"
      }
    ]
  },
  {
    "@id": "https://pid.geoscience.gov.au/def/voc/ga/ContactType/nonconformable-contact",
    "https://prez.dev/identifier": [
      {
        "@value": "ns1:nonconformable-contact"
      }
    ],
    "https://prez.dev/link": [
      {
        "@value": "/catalogs/catalogue:default/collections/ns1:ContactType/items/ns1:nonconformable-contact"
      }
    ],
    "https://prez.dev/label": [
      {
        "@value": "nonconformable contact",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "An unconformable contact between an underlying, older nonstratified geological unit (usually intrusive igneous rocks or metamorphics) and an overlying, younger stratified geological unit.",
        "@language": "en"
      }
    ]
  },
  {
    "@id": "https://pid.geoscience.gov.au/def/voc/ga/ContactType/paraconformable-contact",
    "https://prez.dev/identifier": [
      {
        "@value": "ns1:paraconformable-contact"
      }
    ],
    "https://prez.dev/link": [
      {
        "@value": "/catalogs/catalogue:default/collections/ns1:ContactType/items/ns1:paraconformable-contact"
      }
    ],
    "https://prez.dev/label": [
      {
        "@value": "paraconformable contact",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "An unconformable contact between two geological units in which the bedding of the older, underlying unit is parallel to the bedding of the younger, overlying unit, in which the contact between the two units is planar, and may be coincident with a bedding plane.",
        "@language": "en"
      }
    ]
  },
  {
