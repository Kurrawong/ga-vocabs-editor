      {
        "@value": "Field Geology - Contact Type",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "Type of contact that forms the top or base of a geological unit exposed in a borehole, measured section, or field site.",
        "@language": "en"
      }
    ],
    "https://prez.dev/members": [
