      {
        "@value": "Direct economic loss",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "The monetary value of total or partial destruction of physical assets existing in the affected area. Direct economic loss is nearly equivalent to physical damage.",
        "@language": "en"
      }
    ]
  },
