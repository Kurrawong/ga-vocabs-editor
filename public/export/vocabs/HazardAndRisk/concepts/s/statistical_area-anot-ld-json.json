    "https://prez.dev/label": [
      {
        "@value": "Statistical Area Level 2",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "Statistical Areas Level 2 (SA2s) are medium-sized general purpose areas built to represent communities that interact together socially and economically. Most SA2s have a population range of 3,000 to 25,000 people.",
        "@language": "en"
      }
    ]
  },
