      {
        "@value": "Statistical Area Level 1",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "Statistical Areas Level 1 (SA1s) are designed to maximise the geographic detail available for Census of Population and Housing data while maintaining confidentiality. Most SA1s have a population of between 200 to 800 people.",
        "@language": "en"
      }
    ]
  },
  {
