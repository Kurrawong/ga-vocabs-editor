    "https://prez.dev/label": [
      {
        "@value": "Indirect impact",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "The impacts of a disaster that are not due to the direct, physical outcomes of a hazard event (including declines in output or revenue, and impact on wellbeing of people), and generally arise from disruptions to the flow of goods and services as a result of a disaster e.g. business interruption, lost income.",
