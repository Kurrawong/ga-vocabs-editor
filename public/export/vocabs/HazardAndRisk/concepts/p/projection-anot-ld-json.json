      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "A projection indicates what the future changes in a population would be if the assumptions about future trends actually occur. These assumptions are often based on patterns of change which have previously occurred. A projection is not making a prediction or forecast about what is going to happen, it is indicating what would happen if the assumptions which underpin the projection actually occur.",
        "@language": "en"
      }
    ],
