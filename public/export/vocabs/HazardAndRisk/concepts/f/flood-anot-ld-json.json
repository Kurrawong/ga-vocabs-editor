  {
    "@id": "https://pid.geoscience.gov.au/def/voc/ga/HazardAndRisk/major_flooding",
    "https://prez.dev/identifier": [
      {
        "@value": "ns1:major_flooding"
      }
    ],
    "https://prez.dev/link": [
      {
        "@value": "/catalogs/catalogue:default/collections/ns1:HazardAndRisk/items/ns1:major_flooding"
      }
    ],
    "https://prez.dev/label": [
      {
        "@value": "Major flooding",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "In addition to Moderate flooding, extensive rural areas and/or urban areas are inundated. Many buildings may be affected above the floor level. Properties and towns are likely to be isolated and major rail and traffic routes closed. Evacuation of flood affected areas may be required. Utility services may be impacted.",
        "@language": "en"
      }
    ]
  },
  {
    "@id": "https://pid.geoscience.gov.au/def/voc/ga/HazardAndRisk/minor_flooding",
    "https://prez.dev/identifier": [
      {
        "@value": "ns1:minor_flooding"
      }
    ],
    "https://prez.dev/link": [
      {
        "@value": "/catalogs/catalogue:default/collections/ns1:HazardAndRisk/items/ns1:minor_flooding"
      }
    ],
    "https://prez.dev/label": [
      {
        "@value": "Minor flooding",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "Flooding that causes inconvenience. Low-lying areas next to water courses are inundated. Minor roads may be closed and low-level bridges submerged. In urban areas inundation may affect some backyards and buildings below the floor level as well as bicycle and pedestrian paths. In rural areas removal of stock and equipment may be required.",
        "@language": "en"
      }
    ]
  },
  {
    "@id": "https://pid.geoscience.gov.au/def/voc/ga/HazardAndRisk/moderate_flooding",
    "https://prez.dev/identifier": [
      {
        "@value": "ns1:moderate_flooding"
      }
    ],
    "https://prez.dev/link": [
      {
        "@value": "/catalogs/catalogue:default/collections/ns1:HazardAndRisk/items/ns1:moderate_flooding"
      }
    ],
    "https://prez.dev/label": [
      {
        "@value": "Moderate flooding",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "In addition to Minor flooding, the area of inundation is more substantial. Main traffic routes may be affected. Some buildings may be affected above the floor level. Evacuation of flood affected areas may be required. In rural areas removal of stock is required.",
        "@language": "en"
      }
    ]
  },
