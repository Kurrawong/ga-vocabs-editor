    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "Intense low pressure systems which form over warm ocean waters at low latitudes. Tropical cyclones are associated with strong winds, torrential rain and storm surges (in coastal areas). Gale force winds (greater than 63 km/h) must extend more than halfway around the storm near the centre, and winds must persist for at least 6 hours.",
        "@language": "en"
      }
    ],
