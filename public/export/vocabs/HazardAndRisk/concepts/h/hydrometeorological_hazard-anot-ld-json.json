      }
    ],
    "https://prez.dev/label": [
      {
        "@value": "Flood",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "The overflowing by water of the normal confines of a stream or other body of water, or the accumulation of water by drainage over areas which are not normally submerged.",
        "@language": "en"
      }
    ]
  },
  {
