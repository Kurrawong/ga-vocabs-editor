  {
    "@id": "https://pid.geoscience.gov.au/def/voc/ga/HazardAndRisk/flash_flood",
    "https://prez.dev/identifier": [
      {
        "@value": "ns1:flash_flood"
      }
    ],
    "https://prez.dev/link": [
      {
        "@value": "/catalogs/catalogue:default/collections/ns1:HazardAndRisk/items/ns1:flash_flood"
      }
    ],
    "https://prez.dev/label": [
      {
        "@value": "Flash flood",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "A flood that rises quite rapidly with little or no advance warning, usually as a result of an intense rainfall over a small area or, possibly, an ice jam, a dam failure, etc.",
        "@language": "en"
      }
    ]
  },
  {
    "@id": "https://pid.geoscience.gov.au/def/voc/ga/HazardAndRisk/flood",
    "https://prez.dev/identifier": [
      {
        "@value": "ns1:flood"
