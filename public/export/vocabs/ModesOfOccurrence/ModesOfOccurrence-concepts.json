{"@context":{"iri":"@id","prefLabel":"http://www.w3.org/2004/02/skos/core#prefLabel","altLabels":"http://www.w3.org/2004/02/skos/core#altLabel","definition":"http://www.w3.org/2004/02/skos/core#definition","notation":"http://www.w3.org/2004/02/skos/core#notation","broader":"http://www.w3.org/2004/02/skos/core#broader","scheme":"http://www.w3.org/2004/02/skos/core#inScheme","schemeLabel":"https://prez.dev/schemeLabel"},"@graph":[{"iri":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/akmolith","prefLabel":"akmolith","definition":"an intrusion along a decollement zone, with or without tonguelike extensions into the surrounding rock","broader":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/intrusion","scheme":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence","schemeLabel":"Field Geology - Mode of Occurrence"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/amygdale","prefLabel":"amygdale","definition":"a gas cavity or vesicle in an igneous rock which is filled with secondary minerals","broader":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/volcanic-feature","scheme":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence","schemeLabel":"Field Geology - Mode of Occurrence"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/apophysis","prefLabel":"apophysis","definition":"an offshoot from a larger intrusive body","broader":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/intrusion","scheme":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence","schemeLabel":"Field Geology - Mode of Occurrence"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/band-layer","prefLabel":"band, layer","definition":"a thin layer, compositionally distinct from the surrounding material","scheme":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence","schemeLabel":"Field Geology - Mode of Occurrence"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/batholith","prefLabel":"batholith","definition":"a discordant magma body with exposed surface area of more than 100 square kilometres; typically consists of multiple intrusions.","scheme":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence","schemeLabel":"Field Geology - Mode of Occurrence"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/bed","prefLabel":"bed","definition":"a layer of sedimentary material bounded above and below by more or less well-defined bedding surfaces","broader":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/band-layer","scheme":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence","schemeLabel":"Field Geology - Mode of Occurrence"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/bioclast","prefLabel":"bioclast","definition":"a fragment or clast in a rock composed of the remains of organisms","broader":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/clast","scheme":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence","schemeLabel":"Field Geology - Mode of Occurrence"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/block","prefLabel":"block","definition":"an angular pyroclast > 64 mm","broader":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/pyroclast","scheme":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence","schemeLabel":"Field Geology - Mode of Occurrence"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/bomb","prefLabel":"bomb","definition":"a clot of lava, usually mafic-ultramafic, ejected from a volcanic vent while viscous, and which assumes a rounded shape as it solidifies in flight","broader":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/pyroclast","scheme":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence","schemeLabel":"Field Geology - Mode of Occurrence"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/cactolith","prefLabel":"cactolith","definition":"an obscurely cactus-shaped intrusion.","broader":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/intrusion","scheme":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence","schemeLabel":"Field Geology - Mode of Occurrence"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/cement","prefLabel":"cement","definition":"chemically precipitated material occuring in the space between grains or clasts of a sedimentary rock","scheme":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence","schemeLabel":"Field Geology - Mode of Occurrence"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/chonolith","prefLabel":"chonolith","definition":"an intrusion so irregular as to defy description","broader":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/intrusion","scheme":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence","schemeLabel":"Field Geology - Mode of Occurrence"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/clast","prefLabel":"clast","definition":"a fragment of pre-existing rocks which have been produced by the processes of weathering and/or erosion, and in general transported to a point of deposition.","broader":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/detritus","scheme":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence","schemeLabel":"Field Geology - Mode of Occurrence"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/concretion","prefLabel":"concretion","definition":"a hard, compact mass or aggregate of mineral matter, normally subsperical but commonly oblate, disc-shaped or irregular.  Formed from precipitation from solution about a nucleus or centre","scheme":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence","schemeLabel":"Field Geology - Mode of Occurrence"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/cone-sheet","prefLabel":"cone sheet","definition":"an arcuate dyke that dips 30-45 degrees towards the centre of the arc; occur in concentric sets, presumably converging at a magmatic centre","broader":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/ring-complex","scheme":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence","schemeLabel":"Field Geology - Mode of Occurrence"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/cooling-column","prefLabel":"cooling column","definition":"a cooling unit in a volcanic rock defined by polygonal jointing perpendicular to the flow surface","broader":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/volcanic-feature","scheme":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence","schemeLabel":"Field Geology - Mode of Occurrence"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/corona","prefLabel":"corona","definition":"a zone of minerals, commonly with radial arrangement, around another mineral","broader":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/mineral-overgrowth","scheme":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence","schemeLabel":"Field Geology - Mode of Occurrence"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/cryptoexplosive","prefLabel":"cryptoexplosive","definition":"a volcanic body of rock formed by subsurface explosive activity","broader":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/volcanic-feature","scheme":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence","schemeLabel":"Field Geology - Mode of Occurrence"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/crystal","prefLabel":"crystal","definition":"a homogeneous, solid body of a mineral or element having a regular repeating atomic arrangement","scheme":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence","schemeLabel":"Field Geology - Mode of Occurrence"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/crystalloblast","prefLabel":"crystalloblast","definition":"a crystal of a mineral produced entirely by metamorphic processes","broader":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/crystal","scheme":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence","schemeLabel":"Field Geology - Mode of Occurrence"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/cumulate-mineral","prefLabel":"cumulate mineral","definition":"a crystal formed during accumulation of early-formed crystals from a magma","broader":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/crystal","scheme":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence","schemeLabel":"Field Geology - Mode of Occurrence"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/cupola","prefLabel":"cupola","definition":"a large upward projection of the roof of an igneous intrusion into the country rock above.","broader":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/intrusion","scheme":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence","schemeLabel":"Field Geology - Mode of Occurrence"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/detritus","prefLabel":"detritus","definition":"sedimentary material derived from the waethering and/or erosion","scheme":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence","schemeLabel":"Field Geology - Mode of Occurrence"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/ductolith","prefLabel":"ductolith","definition":"a concordant intrusion, teardrop-shaped in cross section","broader":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/intrusion","scheme":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence","schemeLabel":"Field Geology - Mode of Occurrence"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/dyke","prefLabel":"dyke","definition":"a tabular igneous intrusion that cuts across the bedding or foliation of the country rock","broader":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/intrusion","scheme":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence","schemeLabel":"Field Geology - Mode of Occurrence"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/dyke-swarm","prefLabel":"dyke swarm","definition":"a set of dykes, generally subparallel, with a common origin","broader":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/intrusion","scheme":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence","schemeLabel":"Field Geology - Mode of Occurrence"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/enclave","prefLabel":"enclave","definition":"an inclusion within an igneous rock to which it may or may not be genetically related","broader":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/inclusion","scheme":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence","schemeLabel":"Field Geology - Mode of Occurrence"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/ethmolith","prefLabel":"ethmolith","definition":"a discordant, funnel-shaped intrusion, tapers downward","broader":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/intrusion","scheme":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence","schemeLabel":"Field Geology - Mode of Occurrence"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/extrusive-dome","prefLabel":"extrusion dome","definition":"an extrusion forming a bulbous dome above and around a volcanic vent","broader":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/volcanic-feature","scheme":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence","schemeLabel":"Field Geology - Mode of Occurrence"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/facies","prefLabel":"facies","definition":"a lateral variant of a lithostratigraphic or metamorphic unit","scheme":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence","schemeLabel":"Field Geology - Mode of Occurrence"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/fissure","prefLabel":"fissure","definition":"a volcanic conduit having the form of a crack or fissure.","broader":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/intrusion","scheme":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence","schemeLabel":"Field Geology - Mode of Occurrence"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/floor-ascendant","prefLabel":"floor ascendant","definition":"a upward projection of country rock into an igneous intrusion","scheme":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence","schemeLabel":"Field Geology - Mode of Occurrence"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/glomerocryst","prefLabel":"glomerocryst","definition":"an aggregate of crystals of the same mineral","broader":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/crystal","scheme":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence","schemeLabel":"Field Geology - Mode of Occurrence"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/gneissic-band","prefLabel":"gneissic band","definition":"a compositional band or layer in a gneiss mineralogically distinct from the surrounding material","broader":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/band-layer","scheme":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence","schemeLabel":"Field Geology - Mode of Occurrence"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/grain","prefLabel":"grain","definition":"a mineral or rock particle, generally lacking crystal faces, commonly in relation to sedimentary rocks","scheme":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence","schemeLabel":"Field Geology - Mode of Occurrence"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/graphic-intergrowth","prefLabel":"graphic intergrowth","definition":"a regular poikilitic intergrowth of triangular or linear-angular shaped grains of one mineral within a larger other mineral, typically quartz with alkali feldspar","scheme":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence","schemeLabel":"Field Geology - Mode of Occurrence"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/groundmass","prefLabel":"groundmass","definition":"the finer grained material between the phenocrysts of a porphyritic igneous rock","scheme":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence","schemeLabel":"Field Geology - Mode of Occurrence"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/harpolith","prefLabel":"harpolith","definition":"a phacolith with a vertical axis; indicates multiple deformations","broader":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/phacolith","scheme":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence","schemeLabel":"Field Geology - Mode of Occurrence"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/high-level-pluton","prefLabel":"high-level pluton","definition":"a pluton emplaced at a high or subvolcanic level in the crust","broader":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/intrusion","scheme":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence","schemeLabel":"Field Geology - Mode of Occurrence"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/holoblast","prefLabel":"holoblast","definition":"a crystalloblast that is newly and completely formed during metamorphism","broader":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/crystalloblast","scheme":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence","schemeLabel":"Field Geology - Mode of Occurrence"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/hydrothermal-alteration","prefLabel":"hydrothermal alteration","definition":"a rock or mineral derived from hydrothermal alteration of a rock","scheme":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence","schemeLabel":"Field Geology - Mode of Occurrence"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/hypidioblast","prefLabel":"hypidioblast","definition":"a crystalloblast that is formed during metamorphism and is bounded in part by its characteristic crystal faces","broader":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/crystalloblast","scheme":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence","schemeLabel":"Field Geology - Mode of Occurrence"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/idioblast","prefLabel":"idioblast","definition":"a crystalloblast that is formed during metamorphism and is bounded by its characteristic crystal faces","broader":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/crystalloblast","scheme":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence","schemeLabel":"Field Geology - Mode of Occurrence"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/igneous-band","prefLabel":"igneous band","definition":"a compositional band or layer in an igneous rock mineralogically distict from the surrounding material","broader":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/band-layer","scheme":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence","schemeLabel":"Field Geology - Mode of Occurrence"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/inclusion","prefLabel":"inclusion","definition":"a fragment of older material within an igneous rock to which it may or may not be genetically related","scheme":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence","schemeLabel":"Field Geology - Mode of Occurrence"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/interstitial-material","prefLabel":"interstitial material","definition":"the finer grained material that occurs between coarser grains or particles in a rock","broader":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/cement","scheme":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence","schemeLabel":"Field Geology - Mode of Occurrence"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/intraclast","prefLabel":"intraclast","definition":"a clast or fragment in a sedimentary rock of another penecontemporaneous sedimentary rock that has been eroded within the basin of deposition","broader":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/clast","scheme":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence","schemeLabel":"Field Geology - Mode of Occurrence"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/intrusion","prefLabel":"intrusion","definition":"a body of igneous rock formed by the process of emplacement of magma in pre-existing rock","scheme":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence","schemeLabel":"Field Geology - Mode of Occurrence"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/irregular-vein","prefLabel":"irregular vein","definition":"a vein with no obvious form.","broader":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/vein","scheme":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence","schemeLabel":"Field Geology - Mode of Occurrence"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/laccolith","prefLabel":"laccolith","definition":"a concordant, flat-based, convex-up intrusion","broader":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/intrusion","scheme":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence","schemeLabel":"Field Geology - Mode of Occurrence"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/lava-flow","prefLabel":"lava flow","definition":"a tabular extrusive igneous body.","broader":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/volcanic-feature","scheme":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence","schemeLabel":"Field Geology - Mode of Occurrence"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/lens","prefLabel":"lens","definition":"a discontinuous layer or bed within a sedimentary rock","broader":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/band-layer","scheme":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence","schemeLabel":"Field Geology - Mode of Occurrence"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/leucosome","prefLabel":"leucosome","definition":"the light coloured part of a migmatite or other rock with compositional segregations, usually rich in quartz and feldspar","scheme":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence","schemeLabel":"Field Geology - Mode of Occurrence"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/lopolith","prefLabel":"lopolith","definition":"a large, concordant, typically layered igneous intrusion whose floor is convex-down and whose roof may be convex-down or flat.","broader":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/intrusion","scheme":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence","schemeLabel":"Field Geology - Mode of Occurrence"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/marker-bed","prefLabel":"marker bed","definition":"a laterally continuous stratigraphic marker within another unit.","broader":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/bed","scheme":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence","schemeLabel":"Field Geology - Mode of Occurrence"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/matrix","prefLabel":"matrix","definition":"the finer grained material between the larger grains or clasts of a sedimentary rock","scheme":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence","schemeLabel":"Field Geology - Mode of Occurrence"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/melanosome","prefLabel":"melanosome","definition":"the dark coloured part of a migmatite or other rock with compositional segregations, rich in mafic minerals","scheme":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence","schemeLabel":"Field Geology - Mode of Occurrence"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/microlite","prefLabel":"microlite","definition":"a microscopic crystal that polarises light and has some determinable optical properties","broader":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/crystal","scheme":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence","schemeLabel":"Field Geology - Mode of Occurrence"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/mineral-overgrowth","prefLabel":"mineral overgrowth","definition":"growth of one mineral around the margin of a pre-existing mineral grain","scheme":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence","schemeLabel":"Field Geology - Mode of Occurrence"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/nodule","prefLabel":"nodule","definition":"A small rounded mass of a mineral or mineral aggregate, usually with a contrasting composition from the enclosing sediment or rock matrix in which it is embedded. A fragment of a coarse grained igneous rock occurring within a finer grained rock.","scheme":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence","schemeLabel":"Field Geology - Mode of Occurrence"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/oikocryst","prefLabel":"oikocryst","definition":"the enclosing crystal in a poikolitic texture","broader":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/crystalloblast","scheme":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence","schemeLabel":"Field Geology - Mode of Occurrence"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/oncolite","prefLabel":"oncolite","definition":"a variously shaped, concentrically laminated, calcareous sedimentary structure, usually less than 10 cm in diameter, formed by the accretion of successive layered masses of blue-green algae","broader":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/grain","scheme":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence","schemeLabel":"Field Geology - Mode of Occurrence"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/ooid","prefLabel":"ooid","definition":"a small round or ovate accretionary particle in an oolitic rock, formed of concentric carbonate layers around a nucleus in shallow, wave-agitated water","broader":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/grain","scheme":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence","schemeLabel":"Field Geology - Mode of Occurrence"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/pellet","prefLabel":"pellet","definition":"a small, usually rounded aggregate of clay-sized calcareous (micritic) material, devoid of internal structure, and contained within a well sorted carbonate rock","broader":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/grain","scheme":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence","schemeLabel":"Field Geology - Mode of Occurrence"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/phacolith","prefLabel":"phacolith","definition":"a concordant, lenticular intrusion, emplaced along a fold axis","broader":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/intrusion","scheme":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence","schemeLabel":"Field Geology - Mode of Occurrence"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/phenocryst","prefLabel":"phenocryst","definition":"a relatively large, conspicuous crystal in a porphyrytic igneous rock","broader":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/crystal","scheme":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence","schemeLabel":"Field Geology - Mode of Occurrence"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/pillow","prefLabel":"pillow","definition":"a pillow-like lava body extruded beneath water","broader":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/lava-flow","scheme":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence","schemeLabel":"Field Geology - Mode of Occurrence"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/pipe","prefLabel":"pipe","definition":"a vertical conduit through the Earth's crust below a volcano, through which magmatic materials have passed; usually filled with volcanic breccia and fragments of older rock.","broader":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/intrusion","scheme":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence","schemeLabel":"Field Geology - Mode of Occurrence"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/pisolite","prefLabel":"pisolite","definition":"a small round or ovate accretionary particle, larger and less regular than an ooid, formed by concentric precipitation around a nucleus typically of carbonate (limestone) or iron oxides (laterite)","broader":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/grain","scheme":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence","schemeLabel":"Field Geology - Mode of Occurrence"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/planar-vein","prefLabel":"planar vein","definition":"a vein with length and width significantly greater than its thickness, giving the vein a tabular form.","broader":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/vein","scheme":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence","schemeLabel":"Field Geology - Mode of Occurrence"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/plug","prefLabel":"plug","definition":"a roughly cylindrical mass of congealed magma that fills the conduit of an inactive volcano","broader":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/volcanic-feature","scheme":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence","schemeLabel":"Field Geology - Mode of Occurrence"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/pluton","prefLabel":"pluton","definition":"a deep-seated igneous intrusion","broader":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/intrusion","scheme":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence","schemeLabel":"Field Geology - Mode of Occurrence"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/pod","prefLabel":"pod","definition":"an intrusion of elongate or lenticular form","broader":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/intrusion","scheme":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence","schemeLabel":"Field Geology - Mode of Occurrence"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/poikiloblast","prefLabel":"poikiloblast","definition":"a crystal formed by recrystallisation during metamorphism with numerous inclusions of smaller grains","broader":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/crystalloblast","scheme":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence","schemeLabel":"Field Geology - Mode of Occurrence"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/porphyroblast","prefLabel":"porphyroblast","definition":"a pseudoporphyritic crystal in a rock produced by metamorphic recrystallisation","broader":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/crystalloblast","scheme":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence","schemeLabel":"Field Geology - Mode of Occurrence"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/porphyroclast","prefLabel":"porphyroclast","definition":"a paleoblast within a finer grained recrystalllised and/or pulverised matrix","broader":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/crystal","scheme":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence","schemeLabel":"Field Geology - Mode of Occurrence"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/pseudomorph","prefLabel":"pseudomorph","definition":"a secondary mineral whose outward crystal form has been inherited from the orignal mineral it has replaced","scheme":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence","schemeLabel":"Field Geology - Mode of Occurrence"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/pyroclast","prefLabel":"pyroclast","definition":"a particle ejected during a volcanic eruption","broader":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/volcanic-feature","scheme":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence","schemeLabel":"Field Geology - Mode of Occurrence"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/reaction-rim","prefLabel":"reaction rim","definition":"a peripheral zone around a mineral composed of the products of the reaction of an early solidified mineral with a surrounding melt","broader":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/corona","scheme":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence","schemeLabel":"Field Geology - Mode of Occurrence"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/ring-complex","prefLabel":"ring complex","definition":"an association of ring dykes and cone sheets.","broader":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/intrusion","scheme":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence","schemeLabel":"Field Geology - Mode of Occurrence"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/righ-dyke","prefLabel":"ring dyke","definition":"an arcuate or subcircular dyke, generally associated with a volcanic centre.","broader":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/ring-complex","scheme":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence","schemeLabel":"Field Geology - Mode of Occurrence"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/roof-pendant","prefLabel":"roof pendant","definition":"a downward projection of country rock into an igneous intrusion","scheme":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence","schemeLabel":"Field Geology - Mode of Occurrence"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/sedimentry-dyke","prefLabel":"sedimentary dyke","definition":"a tabular sedimentary intrusion that cuts across the bedding or foliation of the host rock","scheme":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence","schemeLabel":"Field Geology - Mode of Occurrence"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/sheet","prefLabel":"sheet","definition":"a tabular intrusion, concordant or slightly discordant.","broader":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/intrusion","scheme":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence","schemeLabel":"Field Geology - Mode of Occurrence"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/sigmoidal-vein","prefLabel":"sigmoidal vein","definition":"a vein is curved so as to resemble the letter S in section.","broader":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/vein","scheme":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence","schemeLabel":"Field Geology - Mode of Occurrence"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/sill","prefLabel":"sill","definition":"a tabular igneous intrusion that parallels the bedding or foliation of the country rock.","broader":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/intrusion","scheme":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence","schemeLabel":"Field Geology - Mode of Occurrence"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/sphenolith","prefLabel":"sphenolith","definition":"a wedge-like intrusion, partly concordant, partly discordant.","broader":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/intrusion","scheme":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence","schemeLabel":"Field Geology - Mode of Occurrence"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/spherulite","prefLabel":"spherulite","definition":"a rounded or spherical mass of acicular crystals, commonly of feldspar radiating from a central point.  Commonly formed from devitrification of volcanic glass","broader":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/volcanic-feature","scheme":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence","schemeLabel":"Field Geology - Mode of Occurrence"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/stock","prefLabel":"stock","definition":"a discordant magma body with exposed surface area of less than 100 square kilometres; may represent exposed portion of a much larger intrusion.","broader":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/intrusion","scheme":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence","schemeLabel":"Field Geology - Mode of Occurrence"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/symplectic-intergrowth","prefLabel":"symplectic intergrowth","definition":"an intimate wormlike or irregular intergrowth of two different minerals","scheme":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence","schemeLabel":"Field Geology - Mode of Occurrence"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/unkown","prefLabel":"unknown","definition":"mode of occurrence is unknown","scheme":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence","schemeLabel":"Field Geology - Mode of Occurrence"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/vein","prefLabel":"vein","definition":"an epigenetic mineral filling of a fault or fracture in a host rock, in tabular or sheetlike form, often with associated host rock replacement.","scheme":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence","schemeLabel":"Field Geology - Mode of Occurrence"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/volcanic-feature","prefLabel":"volcanic feature","definition":"a rock derived from igneous processes at or just below the Earth's surface","scheme":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence","schemeLabel":"Field Geology - Mode of Occurrence"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/weathering-product","prefLabel":"weathering product","definition":"a secondary mineral or material derived from weathering of a rock","scheme":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence","schemeLabel":"Field Geology - Mode of Occurrence"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/xenoblast","prefLabel":"xenoblast","definition":"a mineral that has grown during metamorphism without development of its characteristic crystal faces","broader":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/crystalloblast","scheme":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence","schemeLabel":"Field Geology - Mode of Occurrence"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/xenocryst","prefLabel":"xenocryst","definition":"a crystal that resembles a phenocryst in an igneous rock, but that is foreign to the rock in which it occurs","broader":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/crystal","scheme":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence","schemeLabel":"Field Geology - Mode of Occurrence"},{"iri":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/xenolith","prefLabel":"xenolith","definition":"a foreign inclusion in an igneous rock; a fragment of an earlier-formed part of the igneous rock that has a different composition from that of the host rock","broader":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence/inclusion","scheme":"https://pid.geoscience.gov.au/def/voc/ga/ModesOfOccurence","schemeLabel":"Field Geology - Mode of Occurrence"}]}