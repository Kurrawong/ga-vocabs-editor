PREFIX : <https://pid.geoscience.gov.au/def/voc/ga/TESTVocab/>
PREFIX cs: <https://pid.geoscience.gov.au/def/voc/ga/TESTVocab>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX schema: <https://schema.org/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

cs:
    a skos:ConceptScheme ;
    skos:definition "TEST vocab"@en ;
    skos:hasTopConcept :tESTconcept5 ;
    skos:prefLabel "TESTVocab"@en ;
.

:tESTconcept5
    a skos:Concept ;
    skos:definition "TEST definition here" ;
    skos:inScheme cs: ;
    skos:prefLabel "TESTconcept5"@en ;
    skos:topConceptOf cs: ;
.


