PREFIX : <https://pid.geoscience.gov.au/def/voc/ga/TESTVOCAB/>
PREFIX cs: <https://pid.geoscience.gov.au/def/voc/ga/TESTVOCAB>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX schema: <https://schema.org/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

cs:
    a skos:ConceptScheme ;
    skos:definition "This is a new test vocab."@en ;
    skos:hasTopConcept :newConceptInNewVocab ;
    skos:prefLabel "TEST VOCAB"@en ;
.

:newConceptInNewVocab
    a skos:Concept ;
    skos:definition "Test" ;
    skos:inScheme cs: ;
    skos:prefLabel "New concept in new vocab"@en ;
    skos:topConceptOf cs: ;
.


