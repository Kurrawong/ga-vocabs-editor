PREFIX : <https://pid.geoscience.gov.au/def/voc/ga/Newvocab/>
PREFIX cs: <https://pid.geoscience.gov.au/def/voc/ga/Newvocab>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX schema: <https://schema.org/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

cs:
    a skos:ConceptScheme ;
    skos:definition "Test Vocab"@en ;
    skos:hasTopConcept :newVocabsConcept ;
    skos:historyNote "Just a test" ;
    skos:prefLabel "New vocab"@en ;
.

:anotherNewConcept
    a skos:Concept ;
    skos:broader :newVocabsConcept ;
    skos:definition "Child new concept" ;
    skos:inScheme cs: ;
    skos:prefLabel "Another new concept"@en ;
.


:newVocabsConcept
    a skos:Concept ;
    skos:definition "NVC definition" ;
    skos:inScheme cs: ;
    skos:narrower :anotherNewConcept ;
    skos:prefLabel "New Vocabs Concept"@en ;
    skos:topConceptOf cs: ;
.


