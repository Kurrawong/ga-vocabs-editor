PREFIX : <https://pid.geoscience.gov.au/def/voc/ga/E2ETestVocabulary/>
PREFIX cs: <https://pid.geoscience.gov.au/def/voc/ga/E2ETestVocabulary>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX schema: <https://schema.org/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

cs:
    a skos:ConceptScheme ;
    skos:prefLabel "E2E Test Vocabulary"@en ;
    skos:definition "A temporary vocabulary created end-to-end through the editor UI to validate the new-vocabulary feature."@en ;
.

:new-concept-1
    a skos:Concept ;
    skos:definition "The first test concept in the E2E-created vocabulary." ;
    skos:inScheme cs: ;
    skos:prefLabel "Test Concept One"@en ;
    skos:topConceptOf cs: ;
.


